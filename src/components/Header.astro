---
// Header component with interactive animated logo and direct concierge contact
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="/" class="pa-logo-link" aria-label="PROJECT:automate Home">
      <div class="pa-logo-container" id="pa-logo-box">
        <img
          src="/assets/logos/logo-static.webp"
          alt="PROJECT:automate Logo"
          class="pa-logo-static"
          width="170"
          height="110"
          loading="eager"
        />
        <img
          src="/assets/logos/logo-animated.gif"
          alt="PROJECT:automate Animated"
          class="pa-logo-gif"
          width="170"
          height="110"
          loading="lazy"
        />
      </div>
    </a>

    <!-- Direct Concierge Contact & Consultation Action -->
    <div class="header-actions">
      <a href="tel:3107405375" class="header-phone-link" aria-label="Direct Phone Concierge">
        <span class="phone-icon-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
      </a>

      <a href="/schedule" class="btn-primary header-cta-btn">
        <span>Schedule Consultation</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(4, 4, 4, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }

  /* Logo */
  .pa-logo-link {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    transition: transform var(--transition-fast);
  }

  .pa-logo-link:hover {
    transform: scale(1.02);
  }

  .pa-logo-container {
    position: relative;
    width: 155px;
    height: 60px;
    cursor: pointer;
  }

  .pa-logo-static,
  .pa-logo-gif {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: opacity 0.35s ease-in-out;
  }

  .pa-logo-static {
    opacity: 1;
    z-index: 2;
  }

  .pa-logo-gif {
    opacity: 0;
    z-index: 1;
  }

  .pa-logo-container:hover .pa-logo-static {
    opacity: 0;
  }

  .pa-logo-container:hover .pa-logo-gif {
    opacity: 1;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Phone Concierge Pill */
  .header-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1.1rem 0.5rem 0.6rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .header-phone-link:hover {
    background: rgba(230, 165, 92, 0.08);
    border-color: rgba(230, 165, 92, 0.35);
    transform: translateY(-1px);
  }

  .phone-icon-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(230, 165, 92, 0.15);
    color: var(--accent-gold);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .header-phone-link:hover .phone-icon-pill {
    background: var(--accent-gold);
    color: #000000;
  }

  .phone-meta {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .phone-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-gold-light);
  }

  .phone-number {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    font-family: var(--font-heading);
  }

  .header-cta-btn {
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .header-inner {
      height: 74px;
    }

    .pa-logo-container {
      width: 135px;
      height: 52px;
    }

    .phone-meta {
      display: none;
    }

    .header-phone-link {
      padding: 0.4rem;
      border-radius: 50%;
    }

    .header-actions {
      gap: 0.75rem;
    }

    .header-cta-btn {
      padding: 0.65rem 1.15rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 480px) {
    .header-cta-btn span {
      display: inline;
    }
  }
</style>

---
import { assetUrl } from '../config/assets';
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="container">
    <div class="final-cta__panel" data-reveal>
      <img
        src={assetUrl('consultationContact')}
        alt="Illuminated waterfront residence at sunset"
        loading="lazy"
        decoding="async"
      />
      <div class="final-cta__wash"></div>
      <div class="final-cta__content">
        <p>By private consultation</p>
        <h2 id="final-cta-title">Designed Exclusively for Your Estate.</h2>
        <span>Thoughtful guidance. Tailored to you.</span>
        <div class="final-cta__actions">
          <a class="primary" href="#consultation-form" data-ghl-form>
            Begin Your Private Consultation <span aria-hidden="true">→</span>
          </a>
          <a class="secondary" href="tel:+13107405375">Speak With Our Design Team</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: #f7f4ed;
    padding: 0 0 clamp(3.5rem, 5vw, 5rem);
  }

  .container {
    margin-inline: auto;
    width: min(var(--page-max), calc(100% - var(--page-gutter) - var(--page-gutter)));
  }

  .final-cta__panel {
    border-radius: 24px;
    color: #fff;
    display: grid;
    min-height: 390px;
    overflow: hidden;
    position: relative;
  }

  .final-cta__panel > img,
  .final-cta__wash {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .final-cta__panel > img {
    object-fit: cover;
    object-position: center 58%;
  }

  .final-cta__wash {
    background: linear-gradient(
      90deg,
      rgb(7 13 18 / 0.95),
      rgb(7 13 18 / 0.7) 58%,
      rgb(7 13 18 / 0.24)
    );
  }

  .final-cta__content {
    align-self: center;
    max-width: 650px;
    padding: clamp(2.25rem, 5vw, 5rem);
    position: relative;
  }

  .final-cta__content > p {
    color: #d9b384;
    font:
      700 0.68rem/1 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.15em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  h2 {
    font:
      400 clamp(2.7rem, 4.5vw, 4.4rem)/0.98 'Cormorant Garamond',
      Georgia,
      serif;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .final-cta__content > span {
    color: #e4ded5;
    display: block;
    font:
      0.92rem/1.5 Inter,
      Arial,
      sans-serif;
    margin-top: 1rem;
  }

  .final-cta__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }

  .primary {
    align-items: center;
    background: #b68a5e;
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font:
      700 0.68rem/1 Inter,
      Arial,
      sans-serif;
    gap: 1rem;
    letter-spacing: 0.075em;
    padding: 1rem 1.25rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .primary:hover {
    background: #c99b6e;
    transform: translateY(-2px);
  }

  .primary span {
    font-size: 1rem;
  }

  .secondary {
    color: #fff;
    font:
      600 0.68rem/1.3 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.07em;
    text-decoration-color: rgb(217 179 132 / 0.7);
    text-underline-offset: 0.4rem;
    text-transform: uppercase;
  }

  @media (max-width: 680px) {
    .final-cta__panel {
      border-radius: 18px;
      min-height: 430px;
    }

    .final-cta__wash {
      background: linear-gradient(90deg, rgb(7 13 18 / 0.94), rgb(7 13 18 / 0.62));
    }

    .final-cta__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

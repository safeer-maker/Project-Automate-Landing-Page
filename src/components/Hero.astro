---
// Hero section for Outdoor Lighting & Audio landing page
---

<section class="hero-section">
  <!-- Video Background -->
  <video
    class="hero-bg-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/assets/images/outdoor-lighting-audio-hero.webp"
    aria-label="Outdoor lighting and audio installation at a luxury home"
  >
    <source src="/assets/video/outdoor-lighting-audio-hero.mp4" type="video/mp4" />
    <source src="/assets/video/outdoor-lighting-audio-hero.webm" type="video/webm" />
  </video>

  <!-- Left-Sided Luxury Vignette Overlay (0% to ~35% dark, clear on right for video) -->
  <div class="hero-bg-overlay"></div>
  <div class="hero-glow hero-glow-top"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-location-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2.2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Manhattan Beach &amp; Coastal SoCal</span>
        </div>
      <!-- Main Headline -->
      <h3 class="hero-title">
        Your Home Shouldn't End at the <span class="text-gradient-gold">Back Door.</span>
      </h3>

      <!-- High-Contrast Luxury Subtitle -->
      <p class="hero-subtitle">
        Architectural landscape lighting and acoustically tuned outdoor audio engineered as one seamless estate experience.
      </p>

      <!-- Single Ultra-Premium Primary CTA -->
      <div class="hero-action-row">
        <a href="#quote-form" class="btn-primary hero-primary-btn">
          <span>Reserve a Private Consultation</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        
      </div>

      <!-- Architectural Feature Editorial Row (Non-card, Human-crafted) -->
      <div class="hero-pillars-wrap">
        <div class="pillar-col">
          <div class="pillar-header">
            <span class="pillar-index">01</span>
            <span class="pillar-accent-line"></span>
          </div>
          <h4 class="pillar-title">Bespoke Architectural Lighting</h4>
        </div>

        <div class="pillar-col">
          <div class="pillar-header">
            <span class="pillar-index">02</span>
            <span class="pillar-accent-line"></span>
          </div>
          <h4 class="pillar-title">Acoustic Soundstage Engineering</h4>
        </div>

        <div class="pillar-col">
          <div class="pillar-header">
            <span class="pillar-index">03</span>
            <span class="pillar-accent-line"></span>
          </div>
          <h4 class="pillar-title">Unified Estate Automation</h4>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
    min-height: calc(100vh - 84px);
    display: flex;
    align-items: center;
    background: #040404;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
    transform: translateZ(0) scale(1.002);
    backface-visibility: hidden;
  }

  /* Left-Sided Overlay: Dark on left (0-35%), completely clear on right (35-100%) */
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(4, 4, 4, 0.88) 0%,
      rgba(4, 4, 4, 0.78) 20%,
      rgba(4, 4, 4, 0.42) 34%,
      rgba(4, 4, 4, 0.12) 42%,
      rgba(4, 4, 4, 0) 50%
    );
    pointer-events: none;
  }

  /* Atmospheric Warm Gold Glow strictly on top-left behind text */
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 1;
  }

  .hero-glow-top {
    top: -120px;
    left: 5%;
    width: 550px;
    height: 350px;
    background: radial-gradient(circle, rgba(230, 165, 92, 0.22) 0%, rgba(230, 165, 92, 0) 70%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-content {
    max-width: min(620px, 44vw);
    margin: 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Headline */
  .hero-title {
    font-size: clamp(2.1rem, 3.4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    color: #ffffff;
  }

  /* High-Contrast Luxury Subtitle */
  .hero-subtitle {
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    color: rgba(241, 245, 249, 0.92);
    margin-bottom: 2.25rem;
    line-height: 1.6;
    font-weight: 350;
    letter-spacing: -0.01em;
  }

  /* Action Row */
  .hero-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .hero-primary-btn {
    padding: 1rem 2.2rem;
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-shadow: 0 6px 25px rgba(230, 165, 92, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-primary-btn:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-arrow {
    transition: transform var(--transition-fast);
  }

  .hero-location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  /* Architectural Feature Editorial Pillars (Clean Row) */
  .hero-pillars-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    width: 100%;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .hero-bg-overlay {
      background:
        linear-gradient(90deg, rgba(4, 4, 4, 0.58) 0%, rgba(4, 4, 4, 0.42) 52%, rgba(4, 4, 4, 0.08) 100%),
        linear-gradient(180deg, rgba(4, 4, 4, 0.08) 0%, rgba(4, 4, 4, 0) 42%, rgba(4, 4, 4, 0.28) 100%);
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero-btn,
    .hero-btn-secondary {
      width: 100%;
    }
    .hero-highlights {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding-left: 1rem;
    }
  }
</style>

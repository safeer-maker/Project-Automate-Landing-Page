---
import { assetUrl } from '../config/assets';
---
<section class="hero" aria-labelledby="hero-title">
  <video autoplay muted loop playsinline preload="auto" poster={assetUrl('heroEstateAtSunset')} aria-label="Illuminated luxury estate with a pool at sunset">
    <source src="/framer-extracted-assets/hero/estate-at-sunset.webm" type="video/webm" />
  </video>
  <div class="overlay"></div>
  <div class="container copy">
    <a class="eyebrow" href="https://maps.app.goo.gl/2BtVSjn9ksfqNbMA9" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.6"/></svg>Los Angeles architectural landscape lighting</a>
    <h1 id="hero-title"> <span class="gold-to-light">Your estate</span> shouldn’t disappear <span class="light-to-gold">after sunset.</span></h1>
    <span class="rule"></span>
    <div class="cta-primary"><a class="button" href="#consultation-form" data-ghl-form><span class="button-copy">Illuminate your property</span><span class="arrow" aria-hidden="true">→</span></a></div>
    <p class="lead">Tell us about your property, project goals, timing, and investment range. Our design team reviews every project before scheduling the next step.</p>
  </div>
</section>
<style>
  .container{margin-inline:auto;width:min(1200px,calc(100% - 80px))}.hero{color:#fff;display:grid;min-height:max(720px,100svh);overflow:hidden;position:relative}.hero>video,.overlay{height:100%;inset:0;object-fit:cover;position:absolute;width:100%}.hero>video{object-position:58% center}.overlay{background:linear-gradient(90deg,#081014e8 0%,#081014a6 43%,#08101424 76%),linear-gradient(0deg,#0810148a 0%,transparent 50%)}.copy{align-self:center;padding:8.5rem 0 3rem;position:relative;z-index:1}.eyebrow{align-items:center;color:#e1b476;display:flex;font:700 .68rem/1.3 Inter,Arial,sans-serif;gap:.55rem;letter-spacing:.14em;margin:0 0 1.25rem;text-decoration:none;text-transform:uppercase;width:max-content}.eyebrow svg{fill:none;height:15px;stroke:currentColor;stroke-width:1.8;width:15px}.eyebrow:hover{color:#fff}.hero h1{font:400 clamp(3.5rem,4.65vw,4.2rem)/1 Arial,Helvetica,sans-serif;letter-spacing:-.04em;margin:0;max-width:760px}.gold-to-light,.light-to-gold{background-clip:text;-webkit-background-clip:text;color:transparent}.gold-to-light{background-image:linear-gradient(105deg,#b68a5e 0%,#e6c99e 34%,#fff 72%)}.light-to-gold{background-image:linear-gradient(105deg,#fff 12%,#f6ead7 48%,#b68a5e 100%)}.rule{background:linear-gradient(90deg,#b68a5e,#f6dfba,transparent);display:block;height:2px;margin:1.55rem 0;width:min(280px,52vw)}.actions{display:flex}.button{align-items:center;background:linear-gradient(110deg,#a9784d,#c99b6e 52%,#aa794e);background-size:200% 100%;border:1px solid rgb(255 235 204 / .3);border-radius:999px;box-shadow:0 12px 30px rgb(0 0 0 / .22);color:#fff;display:inline-flex;gap:1.5rem;padding:.75rem .8rem .75rem 1.45rem;text-decoration:none;transition:background-position .35s ease,transform .25s ease,box-shadow .25s ease}.button:hover{background-position:100% 0;box-shadow:0 16px 36px rgb(0 0 0 / .32);transform:translateY(-2px)}.button-copy{display:grid;font:700 .76rem/1.15 Inter,Arial,sans-serif;letter-spacing:.09em;text-transform:uppercase}.button-copy small{color:#fff9ee;font:600 .57rem/1 Inter,Arial,sans-serif;letter-spacing:.12em;margin-bottom:.35rem}.arrow{align-items:center;background:#fff;border-radius:50%;color:#9d7049;display:inline-flex;font:500 1.3rem/1 Arial;height:38px;justify-content:center;width:38px}.lead{color:#eee9e2;font:.82rem/1.45 Inter,Arial,sans-serif;margin:1.35rem 0 0;max-width:560px}.cta-primary{margin-bottom:.9rem;margin-top:1.05rem}@media(max-width:900px){.container{width:min(1200px,calc(100% - 40px))}.hero{min-height:max(680px,100svh)}.hero h1{font-size:clamp(3.15rem,12.5vw,4rem)}}@media(max-width:680px){.copy{align-self:end;padding:8rem 0 3.5rem}.button{justify-content:space-between;width:100%}.eyebrow{font-size:.6rem;letter-spacing:.1em}}
</style>

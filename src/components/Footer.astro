---
// Complete responsive Footer component matching client website
---

<footer class="site-footer">
  <div class="container">
    <!-- Top CTA Banner inside footer -->
    <div class="footer-cta-banner">
      <div class="footer-cta-text">
        <span class="cta-subtitle">Start Your Transformation</span>
        <h3 class="cta-heading">Ready to automate your home?</h3>
      </div>
      <a href="/schedule" class="btn-primary footer-cta-btn">
        <span>Book a Consultation</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Main Footer Grid -->
    <div class="footer-grid">
      <!-- Col 1: Brand & Tagline -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link">
          <img
            src="/assets/logos/logo-static.webp"
            alt="PROJECT:automate"
            class="footer-logo"
            width="170"
            height="70"
            loading="lazy"
          />
        </a>
        <p class="brand-tagline">
          The art of invisible intelligence. Custom smart home systems for the world's most refined residences.
        </p>
      </div>

      <!-- Col 2: Services -->
      <div class="footer-col">
        <h4 class="footer-col-title">Services</h4>
        <ul class="footer-links">
          <li><a href="/outdoor-lighting-audio">Outdoor Lighting & Audio</a></li>
          <li><a href="/#quote-form">Control Systems</a></li>
          <li><a href="/#quote-form">Security Systems</a></li>
          <li><a href="/#quote-form">Lighting</a></li>
          <li><a href="/#quote-form">Outdoor Living</a></li>
          <li><a href="/#quote-form">Home Cinema</a></li>
          <li><a href="/#quote-form">Audio & Video Solutions</a></li>
          <li><a href="/#quote-form">Motorized Shades & Draperies</a></li>
          <li><a href="/#quote-form">Energy Management</a></li>
        </ul>
      </div>

      <!-- Col 3: Quick Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/#sunset-showcase">About Us</a></li>
          <li><a href="/#quote-form">Design Partner</a></li>
          <li><a href="/#sunset-showcase">Inspiration & Gallery</a></li>
          <li><a href="/schedule">Schedule Consultation</a></li>
          <li><a href="/#contact-section">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 4: Concierge / Contact -->
      <div class="footer-col concierge-col">
        <h4 class="footer-col-title">Concierge</h4>
        <div class="concierge-details">
          <div class="concierge-item">
            <span class="c-label">Direct Line:</span>
            <a href="tel:3107405375" class="c-val">(310) 740-5375</a>
          </div>
          <div class="concierge-item">
            <span class="c-label">Alternate:</span>
            <a href="tel:3104024818" class="c-val">(310) 402-4818</a>
          </div>
          <div class="concierge-item">
            <span class="c-label">Inquiries:</span>
            <a href="mailto:sales@projectautomate.com" class="c-val">sales@projectautomate.com</a>
          </div>
          <div class="concierge-item">
            <span class="c-label">Office & Showroom:</span>
            <p class="c-address">
              1600 Rosecrans Ave, Building 7, Suite 400<br/>
              Manhattan Beach, CA 90266
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="copyright">
        © 2026 PROJECT: automate. All rights reserved.
      </div>
      <div class="legal-links">
        <a href="/#quote-form">Privacy Policy</a>
        <span class="sep">•</span>
        <a href="/#quote-form">Terms & Conditions</a>
        <span class="sep">•</span>
        <span class="credit">Powered by AI Media®</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #020202;
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--border-subtle);
  }

  /* Top CTA Banner inside Footer */
  .footer-cta-banner {
    background: linear-gradient(135deg, #111116 0%, #1a1a24 100%);
    border: 1px solid rgba(230, 165, 92, 0.25);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 768px) {
    .footer-cta-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .cta-subtitle {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 0.4rem;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    font-weight: 700;
  }

  .footer-cta-btn {
    padding: 0.9rem 2rem;
    font-size: 0.98rem;
    white-space: nowrap;
  }

  /* Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Columns */
  .footer-logo {
    width: 170px;
    height: auto;
    margin-bottom: 1.25rem;
  }

  .brand-tagline {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 300px;
  }

  .footer-col-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--accent-gold);
    transform: translateX(4px);
  }

  /* Concierge Details */
  .concierge-details {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .concierge-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .c-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .c-val {
    font-size: 0.95rem;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .c-val:hover {
    color: var(--accent-gold);
  }

  .c-address {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Bottom Bar */
  .footer-bottom {
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .legal-links a:hover {
    color: var(--text-primary);
  }

  .sep {
    opacity: 0.4;
  }

  .credit {
    color: var(--accent-gold-light);
  }
</style>

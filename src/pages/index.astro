---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import TrustSection from '../components/TrustSection.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import ProjectProcessSection from '../components/ProjectProcessSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GhlFormModal from '../components/GhlFormModal.astro';
import { assetUrl } from '../config/assets';
---

<Layout
  title="Architectural Landscape Lighting | PROJECT:automate"
  description="Architectural landscape lighting, outdoor audio, and seamless control for Los Angeles estates."
  ogImage={assetUrl('heroEstateAtSunset')}
  preloadVideo="/framer-extracted-assets/hero/estate-at-sunset.webm"
>
  <SiteHeader />
  <HeroSection />
  <TrustSection />
  <BenefitsSection />
  <ProjectProcessSection />
  <ServicesSection />
  <SiteFooter />
  <GhlFormModal />
</Layout>

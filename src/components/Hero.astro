---
// Hero section for Outdoor Lighting & Audio landing page
---

<section class="hero-section">
  <video
    class="hero-bg-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/assets/images/outdoor-lighting-audio-hero.webp"
    aria-label="Outdoor lighting and audio installation at a luxury home"
  >
    <source src="/assets/video/outdoor-lighting-audio-hero.webm" type="video/webm" />
    <source src="/assets/video/outdoor-lighting-audio-hero.mp4" type="video/mp4" />
  </video>
  <div class="hero-bg-overlay"></div>

  <!-- Atmospheric Lighting Glow Elements -->
  <div class="hero-glow hero-glow-top"></div>
  <div class="hero-glow hero-glow-bottom"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Outdoor Architectural Systems</span>
      </div>

      <h1 class="hero-title">
        Your Home Shouldn't End at the <span class="text-gradient-gold">Back Door.</span>
      </h1>

      <p class="hero-subtitle">
        Architectural landscape lighting and high-performance outdoor audio designed as one seamless outdoor experience.
      </p>

      <div class="hero-actions">
        <a href="#quote-form" class="btn-primary hero-btn">
          <span>Request a Design Consultation</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/schedule" class="btn-secondary hero-btn-secondary">
          <span>Book Direct Call</span>
        </a>
      </div>

      <!-- Quick Feature Trust Highlights -->
      <div class="hero-highlights">
        <div class="highlight-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <span>Architectural Landscape Lighting</span>
        </div>
        <div class="highlight-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
          </svg>
          <span>Acoustically Tuned Outdoor Audio</span>
        </div>
        <div class="highlight-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
          <span>Unified Smart Home Control</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: clamp(4rem, 10vw, 8.5rem) 0 clamp(3.5rem, 8vw, 6rem);
    min-height: min(780px, calc(100vh - 90px));
    display: flex;
    align-items: center;
    background: #040404;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(4, 4, 4, 0.66) 0%, rgba(4, 4, 4, 0.52) 48%, rgba(4, 4, 4, 0.92) 100%),
      radial-gradient(circle at 50% 30%, rgba(230, 165, 92, 0.16), transparent 48%);
    pointer-events: none;
  }

  /* Glow accents */
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    opacity: 0.25;
    z-index: 1;
  }

  .hero-glow-top {
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(circle, #e6a55c 0%, rgba(230, 165, 92, 0) 70%);
  }

  .hero-glow-bottom {
    bottom: -100px;
    right: 10%;
    width: 400px;
    height: 250px;
    background: radial-gradient(circle, #8b5cf6 0%, rgba(139, 92, 246, 0) 70%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    background: rgba(230, 165, 92, 0.08);
    border: 1px solid rgba(230, 165, 92, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-gold-light);
    margin-bottom: 2rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-gold);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-gold);
  }

  /* Heading */
  .hero-title {
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    max-width: 850px;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--text-secondary);
    max-width: 720px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
    font-weight: 300;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .hero-btn {
    padding: 0.95rem 2.2rem;
    font-size: 1.05rem;
  }

  .hero-btn-secondary {
    padding: 0.95rem 2rem;
    font-size: 1.02rem;
  }

  /* Highlights Bar */
  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    width: 100%;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .hero-btn,
    .hero-btn-secondary {
      width: 100%;
    }
    .hero-highlights {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding-left: 1rem;
    }
  }
</style>

---
// Private Consultation CTA Card component matching Section 4
---

<section class="consultation-section" id="contact-section">
  <div class="container">
    <div class="consultation-card">
      <div class="consultation-glow"></div>
      
      <div class="consultation-grid">
        <!-- Content -->
        <div class="consultation-content">
          <h2 class="consultation-title">Prefer to Speak With Us Directly?</h2>
          <p class="consultation-desc">
            If you already have a project in mind and would rather discuss it with our team, schedule a private consultation. We'll review your property, project goals, timeline and investment range and determine whether PROJECT is the right fit.
          </p>

          <div class="consultation-perks">
            <div class="perk-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Choose a time that works for you.</span>
            </div>
            <div class="perk-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Direct review with our senior system architect.</span>
            </div>
            <div class="perk-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>No-obligation property budget & scope feasibility.</span>
            </div>
          </div>

          <div class="consultation-actions">
            <a href="/schedule" class="btn-primary consultation-btn">
              <span>Book a Private Consultation Now</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Image Banner -->
        <div class="consultation-image-wrap">
          <img
            src="/assets/images/consultation-direct.webp"
            alt="Private Consultation at PROJECT:automate"
            class="consultation-img"
            loading="lazy"
            decoding="async"
            width="500"
            height="400"
          />
          <div class="img-glow-accent"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .consultation-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #060608;
    border-bottom: 1px solid var(--border-subtle);
  }

  .consultation-card {
    position: relative;
    background: linear-gradient(135deg, #101014 0%, #17171d 100%);
    border: 1px solid rgba(230, 165, 92, 0.2);
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .consultation-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(230, 165, 92, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .consultation-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .consultation-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .consultation-badge {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .consultation-title {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .consultation-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .consultation-perks {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: #e2e8f0;
  }

  .consultation-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .consultation-btn {
    padding: 0.9rem 2rem;
    font-size: 1rem;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .phone-link:hover {
    color: var(--accent-gold);
  }

  /* Image Wrap */
  .consultation-image-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .consultation-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .consultation-image-wrap:hover .consultation-img {
    transform: scale(1.03);
  }
</style>

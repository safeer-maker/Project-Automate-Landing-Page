---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import TrustSection from '../components/TrustSection.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import ProjectProcessSection from '../components/ProjectProcessSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ConsultationSection from '../components/ConsultationSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { assetUrl } from '../config/assets';
---

<Layout
  title="Architectural Landscape Lighting | PROJECT:automate"
  description="Architectural landscape lighting, outdoor audio, and seamless control for Los Angeles estates."
  ogImage={assetUrl('heroEstateAtSunset')}
>
  <SiteHeader />
  <HeroSection />
  <TrustSection />
  <BenefitsSection />
  <ProjectProcessSection />
  <ServicesSection />
  <ConsultationSection />
  <SiteFooter />
</Layout>

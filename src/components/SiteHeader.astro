---
import { assetUrl } from '../config/assets';

const isHome = Astro.url.pathname === '/';
const link = (anchor: string) => isHome ? anchor : `/${anchor}`;
---

<header class="site-header">
  <nav class="container navigation" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="PROJECT:automate home">
      <img src={assetUrl('brandMark')} width="314" height="184" alt="" />
      <span><strong>PROJECT:</strong><strong>automate</strong></span>
    </a>
    <div class="desktop-links" aria-label="Site sections">
      <a href={link('#approach')}>Our approach</a><a href={link('#services')}>Services</a><a href={link('#booking')}>Contact</a>
    </div>
    <div class="desktop-actions">
      <a class="phone" href="tel:+13107405375">(310) 740-5375</a>
      <a class="button" href={link('#booking')}>Book a consultation <span aria-hidden="true">→</span></a>
    </div>
    <details class="mobile-menu">
      <summary><span>Menu</span><span class="menu-icon" aria-hidden="true"></span></summary>
      <div class="mobile-panel">
        <a href={link('#approach')}>Our approach</a><a href={link('#services')}>Services</a><a href={link('#booking')}>Contact</a>
        <a class="mobile-phone" href="tel:+13107405375">(310) 740-5375</a>
        <a class="button" href={link('#booking')}>Book a consultation <span aria-hidden="true">→</span></a>
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header { left: 0; padding-top: 1.25rem; position: absolute; right: 0; top: 0; z-index: 10; }
  .container { margin-inline: auto; width: min(1200px, calc(100% - 80px)); }
  .navigation { align-items: center; background: rgb(10 17 22 / .8); border: 1px solid rgb(255 255 255 / .16); border-radius: 999px; box-shadow: 0 12px 35px rgb(0 0 0 / .16); display: flex; min-height: 68px; padding: .4rem .55rem .4rem 1.2rem; backdrop-filter: blur(18px); }
  .brand { align-items: center; color: #fff; display: flex; flex-shrink: 0; gap: .7rem; text-decoration: none; }
  .brand img { height: 35px; object-fit: contain; width: 48px; }
  .brand span { display: grid; font: 700 .77rem/.9 Inter, Arial, sans-serif; letter-spacing: -.035em; }
  .brand strong:last-child { color: #d9b384; }
  .desktop-links { display: flex; gap: clamp(1.1rem, 2vw, 2rem); margin-left: auto; }
  .desktop-links a, .phone { color: #f9f7f3; font: 600 .69rem/1 Inter, Arial, sans-serif; letter-spacing: .09em; text-decoration: none; text-transform: uppercase; }
  .desktop-links a { color: #d9d6d0; transition: color .2s ease; }
  .desktop-links a:hover, .phone:hover { color: #d9b384; }
  .desktop-actions { align-items: center; display: flex; gap: clamp(1rem, 2vw, 1.75rem); margin-left: clamp(1.5rem, 3vw, 3.25rem); }
  .button { align-items: center; background: #b68a5e; border-radius: 999px; color: #fff; display: inline-flex; font: 700 .65rem/1 Inter, Arial, sans-serif; gap: .65rem; justify-content: center; letter-spacing: .08em; padding: .9rem 1.1rem; text-decoration: none; text-transform: uppercase; transition: background .2s ease, transform .2s ease; }
  .button:hover { background: #d0a16f; transform: translateY(-1px); }
  a:focus-visible, summary:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .mobile-menu { display: none; margin-left: auto; position: relative; }
  .mobile-menu summary { align-items: center; color: #fff; cursor: pointer; display: flex; font: 700 .67rem/1 Inter, Arial, sans-serif; gap: .65rem; letter-spacing: .1em; list-style: none; padding: .85rem .7rem; text-transform: uppercase; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-icon, .menu-icon::before { background: currentColor; display: block; height: 1px; position: relative; width: 18px; }
  .menu-icon::before { content: ''; position: absolute; top: -5px; }
  .mobile-panel { background: #10181e; border: 1px solid rgb(255 255 255 / .15); border-radius: 18px; box-shadow: 0 18px 40px rgb(0 0 0 / .28); display: grid; gap: 1.25rem; padding: 1.35rem; position: absolute; right: 0; top: calc(100% + .75rem); width: min(290px, calc(100vw - 40px)); }
  .mobile-panel > a:not(.button) { color: #fff; font: 600 .74rem/1 Inter, Arial, sans-serif; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .mobile-phone { color: #d9b384 !important; margin-top: .25rem; }
  @media (max-width: 900px) { .site-header { padding-top: .75rem; } .container { width: min(1200px, calc(100% - 40px)); } .navigation { min-height: 58px; } .brand img { height: 30px; width: 42px; } .brand span { font-size: .69rem; } .desktop-links, .desktop-actions { display: none; } .mobile-menu { display: block; } }
</style>

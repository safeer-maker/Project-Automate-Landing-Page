---
import { assetUrl, assetVariantUrl, MEDIA_BASE_URL } from '../config/assets';

const phonePortrait = '(max-width: 767px) and (orientation: portrait)';
const wideOrLandscape = '(min-width: 768px), (orientation: landscape)';
---

<section class="hero" aria-labelledby="hero-title">
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    data-poster={assetUrl('heroEstateAtSunset')}
    data-poster-portrait={assetVariantUrl('heroEstateAtSunset', 'portrait-823')}
    aria-label="Illuminated luxury estate with a pool at sunset"
    data-hero-video
  >
    {
      /* Sources are picked once, at load. Portrait phones get an 810x1080 crop of exactly the
         window they see (object-position 58%: crop x = (1920 - 810) * 0.58 = 644, so regenerate
         the crop if that changes); everything else gets the 1080p file. Every MP4 comes ahead of
         every WebM: WebKit can claim VP9 WebM support and then stall on the first frame, so
         iPhones need the MP4 first. A browser that ignores media= takes the first MP4. The
         original MP4 stays as a last resort in case a new file is missing. */
    }
    <source
      src={`${MEDIA_BASE_URL}/hero/estate-at-sunset-1080.mp4`}
      type="video/mp4"
      media={wideOrLandscape}
    />
    <source
      src={`${MEDIA_BASE_URL}/hero/estate-at-sunset-portrait.mp4`}
      type="video/mp4"
      media={phonePortrait}
    />
    <source src={`${MEDIA_BASE_URL}/hero/estate-at-sunset.mp4`} type="video/mp4" />
    <source
      src={`${MEDIA_BASE_URL}/hero/estate-at-sunset.webm`}
      type="video/webm"
      media={wideOrLandscape}
    />
    <source
      src={`${MEDIA_BASE_URL}/hero/estate-at-sunset-portrait.webm`}
      type="video/webm"
      media={phonePortrait}
    />
  </video>
  <script is:inline define:vars={{ phonePortrait }}>
    // poster can't take a srcset, so pick it before the browser requests one: portrait phones get
    // the same 823px-wide slice the portrait video shows (72 KB instead of the 190 KB frame).
    {
      const video = document.querySelector('[data-hero-video]');
      const portrait = matchMedia(phonePortrait);
      const setPoster = () => {
        video.poster = portrait.matches ? video.dataset.posterPortrait : video.dataset.poster;
        video.parentElement.style.setProperty('--hero-still', `url(${video.poster})`);
      };
      setPoster();
      portrait.addEventListener?.('change', setPoster);
    }
  </script>
  <div class="container copy">
    <h1 id="hero-title" data-motion style="--reveal-delay: 210ms">
      <span class="gold-to-light">Your estate</span> shouldn’t disappear <span
        class="light-to-gold"
      >
        after sunset.
      </span>
    </h1>
    <span class="rule" data-motion="rule" style="--reveal-delay: 350ms"></span>
  </div>
</section>
<script>
  // Phones can refuse autoplay (iOS Low Power Mode or a hot phone, in-app browsers that want a
  // tap), which leaves the poster up, and iOS then draws its own play button over an autoplay
  // video. So when play() is refused the hero shows the poster as a still (.hero--still hides the
  // video) until a tap starts playback. Pause while the hero or the tab is hidden, resume on
  // return (including a back/forward-cache restore), and stay on the still for reduced motion or
  // Save-Data.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const hero = video?.closest<HTMLElement>('.hero');

  if (video && hero) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData =
      (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData ===
      true;
    const gestures = ['touchend', 'click'] as const;
    let onScreen = true;
    let disabled = false;

    const still = (on: boolean) => hero.classList.toggle('hero--still', on);
    const stopGestures = () => gestures.forEach((type) => window.removeEventListener(type, play));

    function play() {
      if (disabled || !onScreen || document.hidden || !video!.paused) return;
      video!.play().catch((error: DOMException) => {
        if (error.name !== 'NotAllowedError' || disabled) return;
        still(true);
        gestures.forEach((type) => window.addEventListener(type, play, { passive: true }));
      });
    }

    const stop = () => {
      disabled = true;
      stopGestures();
      video.pause();
      still(true);
    };

    video.addEventListener('playing', () => {
      still(false);
      stopGestures();
    });
    // A web view without inline playback would open the video full screen on that tap.
    video.addEventListener('webkitbeginfullscreen', () => {
      (video as HTMLVideoElement & { webkitExitFullscreen?: () => void }).webkitExitFullscreen?.();
      stop();
    });

    if (saveData) {
      stop();
      // Drop the sources so the download stops; the poster stays.
      video.querySelectorAll('source').forEach((source) => source.remove());
      video.load();
    } else if (reducedMotion.matches) {
      stop();
    } else {
      play();
    }
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) stop();
      else if (!saveData) {
        disabled = false;
        play();
      }
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        onScreen = entry.isIntersecting;
        if (onScreen) play();
        else video.pause();
      }).observe(video);
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? video.pause() : play()));
    window.addEventListener('pageshow', (event) => event.persisted && play());
  }
</script>
<style>
  .container {
    margin-inline: auto;
    width: min(1200px, calc(100% - var(--page-gutter) - var(--page-gutter)));
  }
  .hero {
    /* Dark base plus a 200-byte blurred poster, so the white headline never sits on the cream page
       background while the poster and video are still downloading. */
    background: #0d1418
      url('data:image/webp;base64,UklGRsAAAABXRUJQVlA4ILQAAABwBQCdASogABIAPu1krE+ppSQiMBgIATAdiUAToGYRTx2omgWXUxtzHZgGi/ztGuXJlwFAAP7y1Fvz4hXtFF3e0EZJbnyygBxjYHRlpS1TKjo28MMZ1gaqZ2AAss4K5Ax+8bZ1yySDGUENXXx39ftPlWKlBAFrdfwsZVsTJ934KbQ+wNm3yz7sge3OQms6+NMZRAJgSCx4BDVifGUhiR3XRzTsW2RE5ouCihDtpCQOaG3AAAA=')
      58% center / cover no-repeat;
    color: #fff;
    display: grid;
    min-height: max(720px, 100svh);
    overflow: hidden;
    position: relative;
  }
  .hero > video {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }
  .hero > video {
    object-position: 58% center;
  }
  .hero--still {
    background: #081014 var(--hero-still) 58% center / cover no-repeat;
  }
  .hero--still > video {
    visibility: hidden;
  }
  /* The headline sits in the bottom-left corner. The consultation form rises into the bottom of
     the hero (ConsultationSection): beside the headline on desktop, below it on single-column
     layouts, where the copy keeps clear of it. */
  .copy {
    align-self: end;
    padding: 8.5rem 0 calc(var(--form-overlap) + 2.5rem);
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1200px) {
    .copy {
      padding-bottom: clamp(2rem, 6svh, 4rem);
    }
  }
  .hero h1 {
    /* The video has no tint over it, so a soft shadow around the letters keeps the headline
       readable over bright frames. A filter, because text-shadow would paint over the gradient
       text. */
    filter: drop-shadow(0 1px 3px rgb(8 16 20 / 0.7)) drop-shadow(0 4px 22px rgb(8 16 20 / 0.85));
    font:
      400 clamp(3.5rem, 4.65vw, 4.2rem)/1 Arial,
      Helvetica,
      sans-serif;
    letter-spacing: -0.04em;
    margin: 0;
    /* Always breaks after "shouldn’t", so on desktop the headline stays clear of the form. */
    max-width: 10em;
  }
  .gold-to-light,
  .light-to-gold {
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .gold-to-light {
    background-image: linear-gradient(105deg, #b68a5e 0%, #e6c99e 34%, #fff 72%);
  }
  .light-to-gold {
    background-image: linear-gradient(105deg, #fff 12%, #f6ead7 48%, #b68a5e 100%);
  }
  .rule {
    background: linear-gradient(90deg, #b68a5e, #f6dfba, transparent);
    display: block;
    height: 2px;
    margin: 1.55rem 0;
    width: min(280px, 52vw);
  }
  @media (max-width: 900px) {
    .hero {
      min-height: max(680px, 100svh);
    }
    .hero h1 {
      font-size: clamp(3.15rem, 12.5vw, 4rem);
    }
  }
  @media (max-width: 680px) {
    /* The top padding only has to clear the header (about 74px), so the headline and the top of
       the form both fit on the first screen. */
    .copy {
      padding: 6rem 0 calc(var(--form-overlap) + 1.5rem);
    }
  }
</style>

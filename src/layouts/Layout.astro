---
import { framerAssets, mediaUrl } from '../config/assets';
// Self-hosted fonts: the exact families and weights the page used to fetch from Google Fonts.
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Outdoor Lighting & Audio - PROJECT:automate',
  description = 'Your Home Shouldn’t End at the Back Door. Architectural landscape lighting and high-performance outdoor audio designed as one seamless outdoor experience.',
  ogImage = mediaUrl('heroEstateAtSunset'),
} = Astro.props;
---

<!doctype html>
<html lang="en" data-framer-assets={framerAssets.publicDirectory}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Resource hints first so the GHL form's connections warm up before anything else competes for bandwidth -->
    <link rel="preconnect" href="https://api.leadconnectorhq.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.leadconnectorhq.com" />
    <link rel="preconnect" href="https://link.msgsndr.com" crossorigin />
    <link rel="dns-prefetch" href="https://link.msgsndr.com" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <script
      is:inline
      async
      src="https://link.msgsndr.com/js/external-tracking.js"
      data-tracking-id="tk_9d37ae1b083b4d7f96de4bc2b7f4e6b0"></script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Meta Pixel - Lead and booking conversions are fired by the pixel inside the GHL form and calendar -->
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1748478050610981');
      fbq('track', 'PageView');

      // Track link clicks that GHL can't see
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('a[href]');
        if (!link) return;
        const url = new URL(link.href, location.href);

        if (url.protocol === 'tel:' || url.protocol === 'mailto:') {
          fbq('track', 'Contact', { method: url.protocol === 'tel:' ? 'phone' : 'email' });
        } else if (url.hostname === 'maps.google.com') {
          fbq('track', 'FindLocation');
        } else if (url.hostname.replace(/^www\./, '') === 'projectautomate.com') {
          fbq('trackCustom', 'VisitMainWebsite', { destination: url.pathname });
        }
      });
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src="https://www.facebook.com/tr?id=1748478050610981&ev=PageView&noscript=1"
      />
    </noscript>
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>
    <script>
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal], [data-motion]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const reveal = (item: HTMLElement) => {
        if (item.classList.contains('motion-in')) return;
        item.classList.remove('motion-pending');
        item.classList.add('motion-in');

        const complete = () => {
          item.classList.remove('motion-in', 'motion-pending');
          item.classList.add('motion-complete');
        };

        item.addEventListener(
          'animationend',
          (event) => {
            if (event.target === item) complete();
          },
          { once: true },
        );

        // Safety net for interrupted animations, background tabs, and browser edge cases.
        window.setTimeout(complete, 2200);
      };

      const isInViewport = (item: HTMLElement) => {
        const bounds = item.getBoundingClientRect();
        return bounds.bottom > 0 && bounds.top < window.innerHeight;
      };

      if (reducedMotion.matches || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('motion-complete'));
      } else {
        // Items already on screen may have been painted before this script ran. Hiding them now
        // would make them blink, so they stay visible and only off-screen items animate in.
        const pendingItems = Array.from(revealItems).filter((item) => !isInViewport(item));
        revealItems.forEach((item) => {
          item.classList.add(pendingItems.includes(item) ? 'motion-pending' : 'motion-complete');
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              reveal(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px 12% 0px', threshold: 0.01 },
        );

        pendingItems.forEach((item) => observer.observe(item));

        const releaseStuckVisibleItems = () => {
          revealItems.forEach((item) => {
            if (!item.classList.contains('motion-pending') || !isInViewport(item)) return;

            item.classList.remove('motion-pending');
            item.classList.add('motion-complete');
            observer.unobserve(item);
          });
        };

        let fallbackTimer = 0;
        window.addEventListener(
          'scroll',
          () => {
            window.clearTimeout(fallbackTimer);
            fallbackTimer = window.setTimeout(releaseStuckVisibleItems, 350);
          },
          { passive: true },
        );
        window.setTimeout(releaseStuckVisibleItems, 2200);
      }
    </script>
  </body>
</html>

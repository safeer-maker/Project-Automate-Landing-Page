---
import { assetUrl } from '../config/assets';
const features = [['revealArchitecture', 'Reveal architecture', 'Accentuate the details that make your home unique.'], ['highlightLandscaping', 'Highlight landscaping', 'Showcase mature trees, texture, and natural beauty.'], ['improveSafety', 'Improve safety', 'Create comfortable, well-lit pathways and entryways.']] as const;
---
<section id="approach" class="section" aria-labelledby="benefits-title"><div class="container"><div class="heading"><div><p class="eyebrow">Designed for life after sunset</p><h2 id="benefits-title">Your home was designed to be experienced.</h2></div><p>From subtle path lighting to dramatic architectural washes, every layer of light has a purpose—enhancing beauty, improving safety, and extending your lifestyle outdoors.</p></div><div class="features">{features.map(([id,title,copy],index)=><figure class:list={['feature',index===0&&'tall']}><img src={assetUrl(id)} alt={title} loading="lazy"/><figcaption><b>{title}</b><span>{copy}</span></figcaption></figure>)}</div></div></section>
<style>.section{background:#f7f4ed;padding:clamp(5.5rem,9vw,8.5rem) 0}.container{margin-inline:auto;width:min(1200px,calc(100% - 80px))}h2{font:500 clamp(3rem,5.2vw,4.65rem)/.98 'Cormorant Garamond',Georgia,serif;letter-spacing:-.045em;margin:0}.heading{align-items:end;display:grid;gap:clamp(2rem,7vw,7rem);grid-template-columns:1.15fr .85fr;margin-bottom:clamp(3rem,6vw,5.5rem)}.eyebrow{color:#b68a5e;font:700 .69rem/1.3 Inter,Arial,sans-serif;letter-spacing:.16em;margin:0 0 1.15rem;text-transform:uppercase}.heading>p{color:#5f6670;font:1rem/1.65 Inter,Arial,sans-serif;margin:0 0 .35rem;max-width:520px}.features{display:grid;gap:1.25rem;grid-template-columns:.92fr 1.08fr;grid-template-rows:repeat(2,minmax(280px,330px))}.feature{border-radius:20px;margin:0;overflow:hidden;position:relative}.tall{grid-row:span 2}.feature img{height:100%;object-fit:cover;width:100%}.feature figcaption{background:linear-gradient(0deg,#000d,transparent);bottom:0;color:#fff;display:grid;gap:.35rem;left:0;padding:2rem;position:absolute;right:0}.feature b{font:700 .7rem/1.3 Inter,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase}.feature span{font:.9rem/1.4 Inter,Arial,sans-serif}@media(max-width:900px){.container{width:min(1200px,calc(100% - 40px))}.heading{align-items:start;gap:1.75rem;grid-template-columns:1fr}}@media(max-width:680px){.section{padding:5.25rem 0}.features{grid-template-columns:1fr;grid-template-rows:none}.feature,.tall{aspect-ratio:1.2;grid-row:auto}.feature figcaption{padding:1.5rem}}</style>

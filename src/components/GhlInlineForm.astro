---
import { GHL_FORM_ID, GHL_FORM_URL } from '../config/forms';

interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  variant?: 'light' | 'glass';
}

const {
  title = 'Tell Us About Your Outdoor Project',
  eyebrow = 'Private consultation',
  description = 'Share a few details and our design team will review your project before reaching out.',
  variant = 'light',
} = Astro.props;
---

<section class:list={['ghl-inline', `ghl-inline--${variant}`]} aria-labelledby="ghl-inline-title">
  <div class="ghl-inline__heading">
    <p>{eyebrow}</p>
    <h2 id="ghl-inline-title">{title}</h2>
    <span>{description}</span>
  </div>
  <iframe
    src={GHL_FORM_URL}
    fetchpriority="high"
    id={`inline-${GHL_FORM_ID}`}
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="ProjectAutomateLP-Form - InlineWebsite"
    data-height="861"
    data-layout-iframe-id={`inline-${GHL_FORM_ID}`}
    data-form-id={GHL_FORM_ID}
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="ProjectAutomateLP-Form - InlineWebsite"
  >
  </iframe>
</section>

<script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>

<script is:inline define:vars={{ formId: GHL_FORM_ID }}>
  const inlineIframe = document.querySelector(`#inline-${formId}`);

  if (inlineIframe) {
    // Track when form becomes visible (lazy-loaded)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && window.fbq) {
          fbq('track', 'Lead');
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(inlineIframe);

    // Monitor for form submission
    window.addEventListener('message', (event) => {
      if (event.data?.type === 'form' || event.data?.event === 'submit' || event.data?.status === 'success') {
        if (window.fbq) {
          fbq('track', 'Contact');
        }
      }
    });
  }
</script>

<style>
  .ghl-inline {
    background: #f7f4ed;
    border-radius: 20px;
    color: #121820;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .ghl-inline--glass {
    backdrop-filter: blur(18px);
    background: rgb(247 244 237 / 0.9);
    border: 1px solid rgb(255 255 255 / 0.86);
    box-shadow:
      0 30px 70px -25px rgb(18 24 32 / 0.28),
      inset 0 2px 18px rgb(255 255 255 / 0.75);
  }
  .ghl-inline__heading {
    margin-bottom: 1.5rem;
  }
  .ghl-inline__heading p {
    color: #b68a5e;
    font:
      700 0.68rem/1.3 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.15em;
    margin: 0 0 0.7rem;
    text-transform: uppercase;
  }
  .ghl-inline__heading h2 {
    font:
      500 clamp(2rem, 3vw, 2.75rem)/0.95 'Cormorant Garamond',
      Georgia,
      serif;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .ghl-inline__heading span {
    color: #5f6670;
    display: block;
    font:
      0.9rem/1.55 Inter,
      Arial,
      sans-serif;
    margin-top: 0.9rem;
  }
  iframe {
    border: 0;
    border-radius: 8px;
    display: block;
    min-height: 861px;
    width: 100%;
  }

  @media (max-width: 809px) {
    .ghl-inline {
      padding: 1rem;
    }

    .ghl-inline__heading h2 {
      font-size: 2rem;
    }
  }
</style>

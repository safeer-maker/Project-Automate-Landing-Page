---
import HeaderBrand from './header/HeaderBrand.astro';
import HeaderCallButton from './header/HeaderCallButton.astro';
import HeaderCtaButton from './header/HeaderCtaButton.astro';
---

<header class="site-header">
  <nav class="container navigation" aria-label="Primary navigation">
    <HeaderBrand />
    <div class="desktop-actions">
      <HeaderCallButton />
      <HeaderCtaButton />
    </div>
    <div class="mobile-actions">
      <HeaderCallButton />
    </div>
  </nav>
</header>

<div class="cta-bar" data-cta-bar>
  <a href="#consultation-form" data-ghl-form>
    Request Your Complimentary Consultation <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .site-header {
    left: 0;
    padding-top: 1.25rem;
    pointer-events: none;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 100;
  }

  .container {
    margin-inline: auto;
    width: min(1200px, calc(100% - var(--page-gutter) - var(--page-gutter)));
  }

  .navigation {
    align-items: center;
    backdrop-filter: blur(18px);
    background: rgb(10 17 22 / 0.8);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    box-shadow: 0 12px 35px rgb(0 0 0 / 0.16);
    display: flex;
    min-height: 76px;
    padding: 0.4rem 0.55rem 0.4rem 1.35rem;
    pointer-events: auto;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      min-height 0.25s ease;
  }

  .site-header[data-scrolled='true'] .navigation {
    background: rgb(10 17 22 / 0.92);
    box-shadow: 0 14px 38px rgb(0 0 0 / 0.24);
    min-height: 68px;
  }

  .desktop-actions {
    align-items: center;
    display: flex;
    gap: 0.65rem;
    margin-left: auto;
  }

  .mobile-actions {
    align-items: center;
    display: none;
    gap: 0.5rem;
    margin-left: auto;
  }

  .cta-bar {
    display: none;
  }

  @media (max-width: 900px) {
    .site-header {
      padding-top: 0.75rem;
    }

    .navigation {
      min-height: 62px;
    }

    .desktop-actions {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }

    /* On phones the header holds the brand, and the consultation button sits in a bar at the
       bottom of the screen, within thumb reach. */
    .cta-bar {
      bottom: 0;
      display: block;
      left: 0;
      padding: 0 var(--page-gutter) calc(0.75rem + env(safe-area-inset-bottom));
      pointer-events: none;
      position: fixed;
      right: 0;
      transform: translateY(calc(100% + 1rem));
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.5s;
      visibility: hidden;
      z-index: 100;
    }

    .cta-bar[data-visible='true'] {
      transform: none;
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      visibility: visible;
    }

    .cta-bar a {
      align-items: center;
      background: linear-gradient(110deg, #a9784d, #c99b6e 52%, #aa794e);
      border: 1px solid rgb(255 235 204 / 0.3);
      border-radius: 999px;
      box-shadow: 0 14px 34px rgb(8 16 20 / 0.35);
      color: #fff;
      display: flex;
      font:
        700 0.7rem/1.2 Inter,
        Arial,
        sans-serif;
      gap: 1rem;
      justify-content: space-between;
      letter-spacing: 0.08em;
      margin-inline: auto;
      max-width: 520px;
      padding: 0.6rem 0.6rem 0.6rem 1.35rem;
      pointer-events: auto;
      text-decoration: none;
      text-transform: uppercase;
    }

    .cta-bar span {
      align-items: center;
      background: #fff;
      border-radius: 50%;
      color: #9d7049;
      display: inline-flex;
      flex: none;
      font-size: 1.1rem;
      height: 36px;
      justify-content: center;
      width: 36px;
    }
  }

  @media (max-width: 900px) and (prefers-reduced-motion: reduce) {
    .cta-bar,
    .cta-bar[data-visible='true'] {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const updateHeader = () => {
    if (header) header.dataset.scrolled = String(window.scrollY > 24);
  };

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  // The bottom bar (phones) only shows while no other consultation button, the form or the footer
  // is on screen, so there's never a second button competing with the one in view.
  const ctaBar = document.querySelector<HTMLElement>('[data-cta-bar]');

  if (ctaBar) {
    if ('IntersectionObserver' in window) {
      const targets = [
        ...Array.from(document.querySelectorAll('a[data-ghl-form]')).filter(
          (link) => !link.closest('.site-header, [data-cta-bar]'),
        ),
        ...Array.from(document.querySelectorAll('.form-shell, footer')),
      ];
      const onScreen = new Set<Element>();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) =>
          entry.isIntersecting ? onScreen.add(entry.target) : onScreen.delete(entry.target),
        );
        ctaBar.dataset.visible = String(onScreen.size === 0);
      });

      targets.forEach((target) => observer.observe(target));
    } else {
      ctaBar.dataset.visible = 'true';
    }
  }
</script>

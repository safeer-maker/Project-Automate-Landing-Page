---
// Feature Showcase & Architectural Lighting Gallery
const galleryItems = [
  {
    src: '/assets/images/gallery-pathway-lighting.webp',
    title: 'Architectural Pathway & Garden Illumination',
    category: 'Landscape Lighting',
    span: 'col-span-2'
  },
  {
    src: '/assets/images/gallery-patio-ambiance.webp',
    title: 'Submerged & Poolside Luminescence',
    category: 'Pool & Water Features',
    span: 'col-span-1'
  },
  {
    src: '/assets/images/gallery-tree-uplighting.webp',
    title: 'Sculptural Canopy Uplighting',
    category: 'Foliage & Tree Lighting',
    span: 'col-span-1'
  },
  {
    src: '/assets/images/gallery-villa-exterior.webp',
    title: 'Modern Estate Exterior Architecture',
    category: 'Facade Lighting',
    span: 'col-span-2'
  },
  {
    src: '/assets/images/gallery-evening-luxury.webp',
    title: 'High-Fidelity Outdoor Audio & Entertainment',
    category: 'Outdoor Audio Systems',
    span: 'col-span-3'
  }
];
---

<section class="showcase-section" id="sunset-showcase">
  <div class="container">
    <!-- Header -->
    <div class="showcase-header">
      <h2 class="showcase-title">Designed for Life After Sunset.</h2>
      <p class="showcase-desc">
        Your landscaping, architecture and outdoor spaces were designed to be experienced, not disappear when the sun goes down.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid">
      {galleryItems.map((item, index) => (
        <div class={`gallery-card ${item.span}`} data-index={index}>
          <div class="card-image-wrap">
            <img
              src={item.src}
              alt={item.title}
              class="gallery-img"
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
            />
            <div class="card-overlay">
              <div class="overlay-content">
                <span class="card-category">{item.category}</span>
                <h3 class="card-title">{item.title}</h3>
              </div>
              <button class="expand-btn" aria-label="View larger image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase-section {
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background: #040404;
    border-bottom: 1px solid var(--border-subtle);
  }

  .showcase-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
  }

  .showcase-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .showcase-desc {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.6;
    font-weight: 300;
  }

  /* Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .gallery-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    position: relative;
    cursor: pointer;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    border-color: rgba(230, 165, 92, 0.4);
  }

  .col-span-1 {
    grid-column: span 1;
  }

  .col-span-2 {
    grid-column: span 2;
  }

  .col-span-3 {
    grid-column: span 3;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .col-span-1,
    .col-span-2,
    .col-span-3 {
      grid-column: span 1;
    }
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-card:hover .gallery-img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.85) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 1.75rem;
    transition: background 0.3s ease;
  }

  .gallery-card:hover .card-overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 20%, rgba(0,0,0,0.92) 100%);
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .card-category {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-weight: 600;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: #ffffff;
  }

  .expand-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    color: #ffffff;
    opacity: 0;
    transform: translateY(10px);
    transition: all var(--transition-fast);
  }

  .gallery-card:hover .expand-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .expand-btn:hover {
    background: var(--accent-gold);
    color: #000000;
  }
</style>

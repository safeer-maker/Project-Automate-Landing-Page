---
const { title = 'Tell Us About Your Outdoor Project' } = Astro.props;
---

<section class="ghl-inline" aria-labelledby="ghl-inline-title">
  <div class="ghl-inline__heading">
    <p>Private consultation</p>
    <h2 id="ghl-inline-title">{title}</h2>
    <span>Share a few details and our design team will review your project before reaching out.</span>
  </div>
  <iframe
    src="https://api.leadconnectorhq.com/widget/form/ZiepwgoZzuozaOg3NIkl"
    id="inline-ZiepwgoZzuozaOg3NIkl"
    data-layout="{'id':'INLINE'}"
    data-height="1015"
    data-form-id="ZiepwgoZzuozaOg3NIkl"
    title="PROJECT:automate consultation form"
    loading="lazy"
  ></iframe>
</section>

<style>
  .ghl-inline { background: #f7f4ed; border-radius: 20px; color: #121820; overflow: hidden; padding: clamp(1.25rem, 3vw, 2rem); }
  .ghl-inline__heading { margin-bottom: 1.5rem; }
  .ghl-inline__heading p { color: #b68a5e; font: 700 .68rem/1.3 Inter, Arial, sans-serif; letter-spacing: .15em; margin: 0 0 .7rem; text-transform: uppercase; }
  .ghl-inline__heading h2 { font: 500 clamp(2rem, 3vw, 2.75rem)/.95 'Cormorant Garamond', Georgia, serif; letter-spacing: -.04em; margin: 0; }
  .ghl-inline__heading span { color: #5f6670; display: block; font: .9rem/1.55 Inter, Arial, sans-serif; margin-top: .9rem; }
  iframe { border: 0; border-radius: 8px; display: block; min-height: 1015px; width: 100%; }
</style>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Framer asset manifest",
  "type": "object",
  "required": ["publicDirectory", "r2Prefix", "assets"],
  "properties": {
    "publicDirectory": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "r2Prefix": { "type": "string", "pattern": "^[a-z0-9/-]*$" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "source": { "type": "string", "format": "uri" },
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/.-]*$" }
        }
      }
    }
  }
}

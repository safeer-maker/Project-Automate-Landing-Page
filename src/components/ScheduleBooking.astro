---
// Schedule / Private Consultation booking component
---

<section class="schedule-section">
  <!-- Glow Accents -->
  <div class="schedule-glow"></div>

  <div class="container">
    <div class="schedule-header">
      <div class="schedule-tag">Private Appointment</div>
      <h1 class="schedule-title">Schedule Your Consultation</h1>
      <p class="schedule-subtitle">
        Tell us about your project and choose a time that works for you. A Project: Automate specialist will review your needs and help you plan the right system for your home.
      </p>
    </div>

    <!-- Booking Layout -->
    <div class="schedule-grid">
      <!-- Left / Main: Cal.com Responsive Scheduler -->
      <div class="calendar-wrapper card-luxury">
        <div class="calendar-header-bar">
          <div class="live-dot-wrap">
            <span class="live-pulse"></span>
            <span class="live-text">Live Scheduling System</span>
          </div>
          <span class="tz-label">Pacific Time (US & Canada)</span>
        </div>

        <!-- Inline Cal.com Embed Container -->
        <div class="cal-embed-container" id="my-cal-inline-on-site">
          <iframe
            src="https://app.cal.com/projectautomate/on-site?embed=true"
            title="Book Consultation"
            class="cal-iframe"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- Right Column: Consultation Details & Direct Help -->
      <div class="schedule-sidebar">
        <!-- What to Expect Card -->
        <div class="sidebar-card card-luxury">
          <h3 class="card-title">What to Expect</h3>
          <ul class="expectations-list">
            <li>
              <div class="expect-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="expect-text">
                <strong>30–45 Min Discovery</strong>
                <span>We evaluate your architectural layout, lighting goals, and outdoor audio requirements.</span>
              </div>
            </li>
            <li>
              <div class="expect-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <div class="expect-text">
                <strong>Tailored System Scope</strong>
                <span>Receive guidance on fixture selections, zoning, acoustics, and smart automation options.</span>
              </div>
            </li>
            <li>
              <div class="expect-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div class="expect-text">
                <strong>Investment Feasibility</strong>
                <span>Clear investment tiers and phased implementation schedules tailored to your property.</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Direct Contact Card -->
        <div class="sidebar-card card-luxury">
          <h3 class="card-title">Prefer Immediate Assistance?</h3>
          <p class="direct-desc">
            Our concierge team is available Monday through Sunday from 9:00 AM – 5:00 PM PST.
          </p>

          <div class="direct-actions">
            <a href="tel:3107405375" class="btn-primary direct-call-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call (310) 740-5375</span>
            </a>

            <a href="mailto:sales@projectautomate.com" class="direct-email-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>sales@projectautomate.com</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .schedule-section {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
    background: #050507;
    overflow: hidden;
  }

  .schedule-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(circle, rgba(230, 165, 92, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .schedule-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .schedule-tag {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .schedule-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .schedule-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.6;
    font-weight: 300;
  }

  /* Grid */
  .schedule-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .schedule-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Calendar Embed Card */
  .calendar-wrapper {
    overflow: hidden;
    min-height: 650px;
    display: flex;
    flex-direction: column;
  }

  .calendar-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.82rem;
  }

  .live-dot-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
  }

  .live-text {
    color: var(--text-primary);
    font-weight: 500;
  }

  .tz-label {
    color: var(--text-muted);
  }

  .cal-embed-container {
    flex: 1;
    width: 100%;
    min-height: 600px;
  }

  .cal-iframe {
    width: 100%;
    height: 620px;
    border: none;
    background: #000000;
  }

  /* Sidebar */
  .schedule-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-card {
    padding: 2rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: #ffffff;
  }

  .expectations-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .expectations-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .expect-icon {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: var(--radius-sm);
    background: rgba(230, 165, 92, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .expect-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .expect-text strong {
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .expect-text span {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .direct-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .direct-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .direct-call-btn {
    width: 100%;
    padding: 0.85rem;
    font-size: 0.95rem;
  }

  .direct-email-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .direct-email-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }
</style>

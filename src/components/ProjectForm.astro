---
// Interactive Project Request Form component with GoHighLevel Form Integration
---

<section class="form-section" id="quote-form">
  <div class="container">
    <div class="form-grid-wrapper">
      <!-- Left Column: Media / Value Proposition -->
      <div class="form-banner-col">
        <div class="banner-card">
          <div class="banner-image-wrap">
            <img
              src="/assets/images/hero-og-image.webp"
              alt="Outdoor Living Architecture"
              class="banner-main-img"
              loading="lazy"
              width="735"
              height="919"
            />
            <div class="banner-overlay-gradient"></div>
            
            <div class="banner-caption-box">
              <span class="caption-tag">Custom Outdoor Automation</span>
              <h3 class="caption-title">Elevate Your Living Spaces</h3>
              <p class="caption-desc">
                From understated architectural uplighting to concert-grade outdoor soundscapes, we engineer each environment with master precision.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: GoHighLevel Embed Form -->
      <div class="form-content-col">
        <div class="form-card">
          <div class="form-header">
            <h2 class="form-title">Tell Us About Your Outdoor Project</h2>
            <p class="form-subtitle">
              Every property is different. Share a few details about what you are planning and our team will review your project before reaching out.
            </p>
          </div>

          <!-- Active GoHighLevel (GHL / LeadConnector) Embed Form -->
          <div class="ghl-form-container">
            <iframe
              src="https://api.leadconnectorhq.com/widget/form/ZiepwgoZzuozaOg3NIkl"
              style="width:100%;height:100%;min-height:920px;border:none;border-radius:8px"
              id="inline-ZiepwgoZzuozaOg3NIkl" 
              data-layout="{'id':'INLINE'}"
              data-trigger-type="alwaysShow"
              data-trigger-value=""
              data-activation-type="alwaysActivated"
              data-activation-value=""
              data-deactivation-type="neverDeactivate"
              data-deactivation-value=""
              data-form-name="Form 0"
              data-height="1015"
              data-layout-iframe-id="inline-ZiepwgoZzuozaOg3NIkl"
              data-form-id="ZiepwgoZzuozaOg3NIkl"
              data-cookie-consent="true"
              data-cookie-consent-provider="auto"
              title="Form 0"
            >
            </iframe>
            <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
          </div>

          <!-- HIDDEN: Original Custom Form Preserved (Not Deleted) -->
          <div class="legacy-form-hidden-wrapper" style="display: none;" aria-hidden="true">
            <form id="project-request-form" class="custom-metform" novalidate>
              <div class="form-group">
                <label class="form-label">What are you interested in? <span class="req">*</span></label>
                <div class="pill-options">
                  <button type="button" class="pill-btn" data-field="interest" data-value="Landscape Lighting">Landscape Lighting</button>
                  <button type="button" class="pill-btn" data-field="interest" data-value="Outdoor Audio">Outdoor Audio</button>
                  <button type="button" class="pill-btn" data-field="interest" data-value="Both">Both</button>
                </div>
                <input type="hidden" name="interest" id="input-interest" />
              </div>
              <div class="form-group">
                <label class="form-label">When are you planning to start? <span class="req">*</span></label>
                <div class="pill-options">
                  <button type="button" class="pill-btn" data-field="timeline" data-value="Immediately">Immediately</button>
                  <button type="button" class="pill-btn" data-field="timeline" data-value="Within 1 month">Within 1 month</button>
                  <button type="button" class="pill-btn" data-field="timeline" data-value="1–6 months">1–6 months</button>
                  <button type="button" class="pill-btn" data-field="timeline" data-value="Just exploring">Just exploring</button>
                </div>
                <input type="hidden" name="timeline" id="input-timeline" />
              </div>
              <div class="form-group">
                <label class="form-label">What budget range are you considering? <span class="req">*</span></label>
                <div class="pill-options">
                  <button type="button" class="pill-btn" data-field="budget" data-value="$10K–$25K">$10K–$25K</button>
                  <button type="button" class="pill-btn" data-field="budget" data-value="$25K–$50K">$25K–$50K</button>
                  <button type="button" class="pill-btn" data-field="budget" data-value="$50K–$100K">$50K–$100K</button>
                  <button type="button" class="pill-btn" data-field="budget" data-value="$100K+">$100K+</button>
                </div>
                <input type="hidden" name="budget" id="input-budget" />
              </div>
              <input type="text" id="input-zip" name="zip" />
              <input type="text" id="input-fname" name="firstName" />
              <input type="text" id="input-lname" name="lastName" />
              <input type="tel" id="input-phone" name="phone" />
              <input type="email" id="input-email" name="email" />
              <input type="checkbox" name="smsConsent" id="input-sms-consent" />
              <input type="checkbox" name="termsAgreement" id="input-terms" />
              <button type="submit" id="submit-btn">Submit Request</button>
            </form>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .form-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #08080a;
    border-bottom: 1px solid var(--border-subtle);
  }

  .form-grid-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 3.5rem;
    align-items: stretch;
  }

  @media (max-width: 1024px) {
    .form-grid-wrapper {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Left Banner Card */
  .banner-card {
    height: 100%;
    min-height: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-subtle);
  }

  .banner-image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .banner-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.85) 100%);
  }

  .banner-caption-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.5rem 2rem;
    z-index: 2;
  }

  .caption-tag {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
    display: block;
  }

  .caption-title {
    font-size: 1.6rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .caption-desc {
    font-size: 0.95rem;
    color: #d1d5db;
    line-height: 1.5;
  }

  /* Right Form Card */
  .form-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
  }

  .form-header {
    margin-bottom: 1.5rem;
  }

  .form-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .form-subtitle {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* GHL Form Embed Container */
  .ghl-form-container {
    width: 100%;
    min-height: 850px;
    background: transparent;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .form-card {
      padding: 1.25rem;
    }
  }
</style>

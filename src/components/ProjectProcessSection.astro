---
import { assetUrl } from '../config/assets';

const steps = [
  {
    number: '01',
    title: 'Project Brief & Discovery',
    copy: 'We start by understanding your property, goals, timeline, and investment range to determine the right direction for your project.',
  },
  {
    number: '02',
    title: 'Site & Design Evaluation',
    copy: 'We evaluate the architecture, landscaping, existing conditions, sightlines, and technical requirements to develop a lighting approach specific to your property.',
  },
  {
    number: '03',
    title: 'Design & Installation',
    copy: 'You receive a tailored lighting design and detailed proposal. Once approved, our team installs every element with precision and respect for your property.',
  },
  {
    number: '04',
    title: 'Commissioning & Support',
    copy: 'After dark, we fine-tune fixture placement, brightness, scenes, and controls to achieve the intended effect—then remain available for ongoing support.',
  },
] as const;
---

<section id="process" class="process-section" aria-labelledby="process-title">
  <div class="container process-layout">
    <div class="project-column">
      <header class="section-heading" data-reveal>
        <p class="eyebrow">Our design + build process</p>
        <h2 id="process-title">From First Conversation to Final Adjustment.</h2>
      </header>

      <div class="project-collage" data-reveal style="--reveal-delay: 100ms">
        <img
          class="project-main"
          src={assetUrl('designBuildProcess')}
          width="1200"
          height="1000"
          alt="Architectural step lighting at a completed residence"
          loading="lazy"
          decoding="async"
        />
        <div class="project-details" aria-hidden="true">
          <img
            src={assetUrl('projectCaseStudy')}
            width="1280"
            height="1280"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            src={assetUrl('projectCaseStudyDetail')}
            width="620"
            height="333"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>

        <article class="project-note">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 11.5 12 4l9 7.5"></path>
            <path d="M5.5 10.5V21h13V10.5M9 21v-6h6v6"></path>
          </svg>
          <div>
            <strong>Real Project</strong>
            <h3>Palos Verdes Estate</h3>
            <span></span>
            <p>
              A dated lighting system was redesigned with layered architectural, landscape, and
              pathway lighting to reveal the property after dark.
            </p>
          </div>
        </article>
      </div>
    </div>

    <ol class="process-list" aria-label="Our four-step design and build process">
      {
        steps.map((step, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <span class="number" aria-hidden="true">
              {step.number}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-section {
    background: #f7f4ed;
    color: #121820;
    padding: clamp(4.25rem, 5vw, 5.5rem) 0;
    scroll-margin-top: 90px;
  }

  .container {
    margin-inline: auto;
    width: min(var(--page-max), calc(100% - var(--page-gutter) - var(--page-gutter)));
  }

  .process-layout {
    align-items: start;
    display: grid;
    gap: clamp(2rem, 3.5vw, 4rem);
    grid-template-columns: minmax(0, 0.95fr) minmax(440px, 1.05fr);
  }

  .section-heading {
    margin-bottom: 2.75rem;
  }

  .eyebrow {
    color: #b68a5e;
    font:
      700 0.7rem/1 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.14em;
    margin: 0 0 1.1rem;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    font:
      400 clamp(2.6rem, 3.35vw, 3rem) / 1.05 Arial,
      Helvetica,
      sans-serif;
    letter-spacing: -0.045em;
    margin-bottom: 0;
    max-width: 600px;
  }

  .project-collage {
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(150px, 1fr);
    height: clamp(440px, 32vw, 520px);
    position: relative;
  }

  .project-collage img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .project-main {
    border-radius: 20px 0 0 20px;
    object-position: 43% center;
  }

  .project-details {
    display: grid;
    gap: 10px;
    grid-template-rows: 1fr 0.72fr;
    padding-left: 10px;
  }

  .project-details img:first-child {
    border-radius: 0 20px 0 0;
  }

  .project-details img:last-child {
    border-radius: 0 0 20px;
  }

  .project-note {
    align-items: flex-start;
    backdrop-filter: blur(18px);
    background: rgb(255 255 255 / 0.8);
    border: 1px solid rgb(255 255 255 / 0.86);
    border-radius: 14px;
    bottom: -2.25rem;
    box-shadow:
      0 24px 50px -20px rgb(0 0 0 / 0.2),
      inset 0 2px 16px rgb(255 255 255 / 0.72);
    display: flex;
    gap: 0.85rem;
    left: 3.5rem;
    max-width: 430px;
    padding: 1.35rem 1.4rem 1.25rem;
    position: absolute;
    width: calc(100% - 5rem);
  }

  .project-note svg {
    fill: none;
    flex: 0 0 auto;
    height: 34px;
    stroke: #b68a5e;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    width: 34px;
  }

  .project-note strong {
    display: block;
    font:
      700 0.66rem/1 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-note h3 {
    font:
      400 1.65rem/1.02 Arial,
      Helvetica,
      sans-serif;
    letter-spacing: -0.035em;
    margin: 0.18rem 0 0;
  }

  .project-note span {
    background: #b68a5e;
    display: block;
    height: 2px;
    margin: 0.85rem 0;
    width: 42px;
  }

  .project-note p {
    color: #5f6670;
    font:
      0.7rem/1.5 Inter,
      Arial,
      sans-serif;
    margin-bottom: 0;
  }

  .process-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .process-list li {
    border-bottom: 1px solid rgb(182 138 94 / 0.35);
    display: grid;
    gap: 1.7rem;
    grid-template-columns: 74px minmax(0, 1fr);
    min-height: 164px;
    padding: 0.75rem 0 1.8rem;
  }

  .process-list li + li {
    padding-top: 1.8rem;
  }

  .number {
    border-right: 1px solid #b68a5e;
    color: #b68a5e;
    font:
      400 3.65rem/1 'Cormorant Garamond',
      Georgia,
      serif;
    letter-spacing: -0.05em;
    padding-right: 1.25rem;
  }

  .process-list h3 {
    font:
      400 1.7rem/1.15 Arial,
      Helvetica,
      sans-serif;
    letter-spacing: -0.035em;
    margin-bottom: 0.7rem;
  }

  .process-list p {
    color: #5f6670;
    font:
      0.83rem/1.6 Inter,
      Arial,
      sans-serif;
    margin-bottom: 0;
  }

  @media (max-width: 1199px) {
    .process-layout {
      grid-template-columns: 1fr;
    }

    .section-heading {
      margin-bottom: 2.25rem;
      max-width: 680px;
    }

    .project-collage {
      height: 460px;
    }

    .project-note {
      max-width: 440px;
    }

    .process-list {
      margin-top: 3.25rem;
    }
  }

  @media (max-width: 809px) {
    .process-section {
      padding: 4rem 0 3.75rem;
    }

    h2 {
      font-size: clamp(2.35rem, 10vw, 2.7rem);
    }

    .project-collage {
      display: block;
      height: 482px;
      margin-bottom: 8.5rem;
    }

    .project-main {
      border-radius: 18px;
    }

    .project-details {
      display: none;
    }

    .project-note {
      bottom: -6.5rem;
      left: 1rem;
      max-width: 320px;
      padding: 1.15rem;
      width: calc(100% - 2rem);
    }

    .project-note h3 {
      font-size: 1.4rem;
    }

    .process-list {
      margin-top: 0;
    }

    .process-list li {
      gap: 1.15rem;
      grid-template-columns: 58px minmax(0, 1fr);
      min-height: 0;
      padding: 1.4rem 0;
    }

    .number {
      font-size: 2.65rem;
      padding-right: 0.9rem;
    }

    .process-list h3 {
      font-size: 1.3rem;
    }
  }
</style>

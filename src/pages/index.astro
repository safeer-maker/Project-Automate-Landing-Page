---
import Layout from '../layouts/Layout.astro';
import GhlInlineForm from '../components/GhlInlineForm.astro';
import { assetUrl } from '../config/assets';

const features = [
  ['revealArchitecture', 'Reveal architecture', 'Accentuate the details that make your home unique.'],
  ['highlightLandscaping', 'Highlight landscaping', 'Showcase mature trees, texture and natural beauty.'],
  ['improveSafety', 'Improve safety', 'Create comfortable, well-lit pathways and entryways.'],
] as const;
const services = [
  ['landscapeLightingService', 'Landscape Lighting', 'Architectural, pathway and garden lighting designed with precision.'],
  ['outdoorAudioService', 'Outdoor Audio', 'Discreet, high-performance audio that elevates outdoor living.'],
  ['smartControlService', 'Smart Control', 'Effortless control of lighting, audio and environments from anywhere.'],
] as const;
const steps = [
  ['01', 'Project Brief & Discovery', 'We start by understanding your property, goals, timeline, and investment range.'],
  ['02', 'Site & Design Evaluation', 'We study architecture, landscaping, sightlines, and technical requirements.'],
  ['03', 'Design & Installation', 'You receive a tailored lighting design and detailed proposal before installation.'],
  ['04', 'Commissioning & Support', 'We fine-tune every scene after dark and remain available for ongoing support.'],
];
---

<Layout title="Architectural Landscape Lighting | PROJECT:automate" description="Architectural landscape lighting, outdoor audio, and seamless control for Los Angeles estates." ogImage={assetUrl('heroEstateAtSunset')}>
  <header class="header"><nav class="container nav" aria-label="Primary navigation"><a href="/" aria-label="PROJECT:automate home"><img src={assetUrl('brandMark')} alt="PROJECT:automate" /></a><div><a class="phone" href="tel:+13107405375">(310) 740-5375</a><a class="button small" href="#consultation" data-open-ghl-form>Request a Consultation <span>→</span></a></div></nav></header>

  <section class="hero"><img src={assetUrl('heroEstateAtSunset')} alt="Illuminated luxury estate with a pool at sunset" fetchpriority="high" /><div class="hero-overlay"></div><div class="container hero-copy"><p class="eyebrow">Architectural landscape lighting for Los Angeles estates</p><h1>Your estate shouldn’t disappear after sunset.</h1><p>Tell us about your property, project goals, timing, and investment range. Our design team reviews every project before scheduling the next step.</p><a class="button" href="#consultation" data-open-ghl-form>Request a Private Lighting Consultation <span>→</span></a></div></section>

  <section class="trust"><div class="container trust-grid"><article><img src={assetUrl('htaCertification')} alt="HTA Certified" /><div><b>HTA Certified</b><span>Home Technology Association</span></div></article><article><img src={assetUrl('cediaMembership')} alt="CEDIA Membership" /><div><b>CEDIA Membership</b><span>Industry-recognized expertise</span></div></article><article><img src={assetUrl('industryMembership')} alt="Smart home industry member" /><div><b>17+ Years</b><span>Member of the smart home industry</span></div></article></div></section>

  <section class="light section"><div class="container"><div class="heading"><p class="eyebrow">Designed for life after sunset</p><h2>Your home was designed to be experienced.</h2><p>From subtle path lighting to dramatic architectural washes, we use light with precision and purpose—enhancing beauty, improving safety, and extending your lifestyle outdoors.</p></div><div class="feature-grid">{features.map(([id, title, copy], index) => <figure class:list={['feature', index === 0 && 'feature-tall']}><img src={assetUrl(id)} alt={title} loading="lazy" /><figcaption><b>{title}</b><span>{copy}</span></figcaption></figure>)}</div></div></section>

  <section class="dark section"><div class="container process-intro"><div class="heading"><p class="eyebrow">Our design + build process</p><h2>From First Conversation to Final Adjustment.</h2></div><img src={assetUrl('designBuildProcess')} alt="Landscape lighting design process" loading="lazy" /></div><div class="container case-study"><div><img src={assetUrl('projectCaseStudy')} alt="Landscape lighting project" loading="lazy" /><img src={assetUrl('projectCaseStudyDetail')} alt="Lighting detail" loading="lazy" /></div><div><p class="eyebrow">Real project</p><h3>Lighting that reveals the property after dark.</h3><p>A dated lighting system was redesigned with layered architectural, landscape, and pathway lighting.</p></div></div><ol class="container steps">{steps.map(([number, title, copy]) => <li><span>{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>

  <section class="light section"><div class="container"><div class="heading"><p class="eyebrow">Complete outdoor experience</p><h2>Landscape Lighting. Outdoor Audio. Seamless Control.</h2></div><div class="services">{services.map(([id, title, copy]) => <article><img src={assetUrl(id)} alt={title} loading="lazy" /><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

  <section id="consultation" class="consultation section"><div class="container consultation-grid"><div><p class="eyebrow">Get in touch</p><h2>Request a private lighting consultation.</h2><p>We will review your property, goals, timeline, and investment range to determine the right next step.</p><a class="button" href="#consultation" data-open-ghl-form>Start your consultation <span>→</span></a></div><img src={assetUrl('consultationContact')} alt="Luxury outdoor living at sunset" loading="lazy" /><GhlInlineForm /></div></section>
</Layout>

<style>
  :global(html), :global(body) { background: #f7f4ed; color: #121820; } :global(body) { margin: 0; }
  .container { margin: auto; width: min(1200px, calc(100% - 80px)); }.section { padding: clamp(5.5rem,10vw,9rem) 0; }.light { background: #f7f4ed; }.dark, .consultation { background: #121820; color: #fff; }
  h1,h2,h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; letter-spacing: -.045em; line-height: .96; margin: 0; } h2 { font-size: clamp(3rem,5.5vw,4.7rem); max-width: 780px; } h3 { font-size: clamp(1.8rem,2.5vw,2.6rem); } p { font: 1rem/1.65 Inter,Arial,sans-serif; }.eyebrow { color: #b68a5e; font: 700 .69rem/1.3 Inter,Arial,sans-serif; letter-spacing: .16em; margin: 0 0 1.2rem; text-transform: uppercase; }.heading { margin-bottom: clamp(3rem,7vw,6rem); }.heading > p:last-child { color: #5f6670; margin-top: 1.6rem; max-width: 630px; }
  .button { align-items: center; background: #b68a5e; border-radius: 999px; color: #fff; display: inline-flex; font: 700 .7rem/1 Inter,Arial,sans-serif; gap: .8rem; letter-spacing: .08em; padding: 1.12rem 1.5rem; text-decoration: none; text-transform: uppercase; transition: .2s ease; }.button:hover { background: #9d7049; transform: translateY(-2px); }.small { font-size: .6rem; padding: .82rem 1rem; }
  .header { left: 0; padding-top: 1.25rem; position: absolute; right: 0; top: 0; z-index: 2; }.nav { align-items: center; backdrop-filter: blur(8px); background: #fff6; border: 1px solid #fffb; border-radius: 999px; box-sizing: border-box; display: flex; justify-content: space-between; min-height: 68px; padding: .4rem 1rem .4rem 1.25rem; }.nav img { display: block; height: 36px; object-fit: contain; width: auto; }.nav div { align-items: center; display: flex; gap: 1.25rem; }.phone { color: #121820; font: 700 .7rem Inter,Arial,sans-serif; text-decoration: none; }
  .hero { color: #fff; min-height: 100svh; overflow: hidden; position: relative; }.hero > img,.hero-overlay { height: 100%; inset: 0; object-fit: cover; position: absolute; width: 100%; }.hero-overlay { background: linear-gradient(90deg,#081014cf 0%,#08101476 44%,#08101410 80%),linear-gradient(0deg,#08101477,transparent 50%); }.hero-copy { bottom: clamp(3rem,10vw,9rem); position: absolute; z-index: 1; }.hero h1 { animation: reveal .9s both; font-size: clamp(3.6rem,7vw,6.7rem); max-width: 760px; }.hero-copy > p:not(.eyebrow) { animation: reveal .9s .15s both; color: #eee9e2; margin: 1.8rem 0; max-width: 550px; }.hero .button { animation: reveal .9s .3s both; } @keyframes reveal { from { filter: blur(10px); opacity: .01; transform: translateY(10px); } }
  .trust { background: #f7f4ed; padding: 2.5rem 0; }.trust-grid { display: grid; gap: 2rem; grid-template-columns: repeat(3,1fr); }.trust article { align-items: center; display: flex; gap: 1rem; }.trust img { height: 52px; object-fit: contain; width: 72px; }.trust b,.trust span { display: block; font-family: Inter,Arial,sans-serif; }.trust b { font-size: .88rem; }.trust span { color: #5f6670; font-size: .75rem; margin-top: .2rem; }
  .feature-grid { display: grid; gap: 1.25rem; grid-template-columns: .85fr 1.15fr; }.feature { margin: 0; min-height: 315px; overflow: hidden; position: relative; }.feature-tall { grid-row: span 2; }.feature img { border-radius: 20px; height: 100%; min-height: 315px; object-fit: cover; width: 100%; }.feature figcaption { background: linear-gradient(0deg,#000b,transparent); bottom: 0; color: #fff; display: grid; gap: .3rem; left: 0; padding: 2rem; position: absolute; right: 0; }.feature b { font: 700 .7rem/1.3 Inter,Arial,sans-serif; letter-spacing: .13em; text-transform: uppercase; }.feature span { font: .9rem/1.4 Inter,Arial,sans-serif; }
  .process-intro,.case-study { align-items: center; display: grid; gap: clamp(2rem,6vw,6rem); grid-template-columns: 1fr .8fr; }.process-intro .heading { margin: 0; }.process-intro > img { border-radius: 20px; max-height: 400px; object-fit: cover; width: 100%; }.case-study { margin-top: clamp(5rem,10vw,9rem); }.case-study > div:first-child { display: grid; gap: 1rem; grid-template-columns: 1fr .6fr; }.case-study img { border-radius: 20px; height: 350px; object-fit: cover; width: 100%; }.case-study img:last-child { align-self: end; height: 210px; }.case-study p:last-child,.steps p { color: #dcd4c8; }.steps { display: grid; grid-template-columns: repeat(2,1fr); margin-top: 6rem; padding: 0; }.steps li { border-top: 1px solid #fff4; display: grid; gap: 1.4rem; grid-template-columns: 55px 1fr; list-style: none; padding: 2rem 1.5rem 2rem 0; }.steps li:nth-child(odd) { margin-right: 1.5rem; }.steps li > span { color: #b68a5e; font: 500 2rem/1 'Cormorant Garamond',Georgia,serif; }.steps h3 { font-size: 1.7rem; }.steps p { font-size: .9rem; margin-top: .6rem; }
  .services { display: grid; gap: 1.25rem; grid-template-columns: repeat(3,1fr); }.services img { aspect-ratio: 1.35; border-radius: 20px; object-fit: cover; width: 100%; }.services h3 { margin: 1.2rem 0 .65rem; }.services article p { color: #5f6670; font-size: .92rem; }
  .consultation-grid { align-items: start; display: grid; gap: 3rem; grid-template-columns: .9fr .55fr 1fr; }.consultation-grid > div:first-child { padding-top: 2rem; }.consultation-grid > div:first-child > p:not(.eyebrow) { color: #dcd4c8; margin: 1.5rem 0 2rem; }.consultation-grid > img { border-radius: 20px; height: 560px; object-fit: cover; width: 100%; }.consultation-grid > :global(.ghl-inline) { min-width: 0; }
  @media (max-width:1199px) { .consultation-grid { grid-template-columns: 1fr 1fr; }.consultation-grid > :global(.ghl-inline) { grid-column: 1/-1; } } @media (max-width:809px) { .container { width: min(100% - 40px,1200px); }.header { padding-top: .75rem; }.nav { min-height: 58px; }.nav img { height: 29px; }.phone { display: none; }.hero h1 { font-size: clamp(3.3rem,15vw,4.7rem); }.hero .button { width: 100%; }.trust-grid,.feature-grid,.process-intro,.case-study,.services,.consultation-grid { grid-template-columns: 1fr; }.trust-grid { gap: 1.25rem; }.feature-tall { grid-row: auto; }.case-study > div:first-child { grid-template-columns: 1fr .65fr; }.case-study img { height: 260px; }.case-study img:last-child { height: 160px; }.steps { grid-template-columns: 1fr; margin-top: 4rem; }.steps li:nth-child(odd) { margin-right: 0; }.consultation-grid > img { height: 440px; } }
  @media (prefers-reduced-motion:reduce) { .hero h1,.hero-copy > p:not(.eyebrow),.hero .button { animation: none; } }
</style>

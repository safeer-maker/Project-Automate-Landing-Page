---
const formUrl = 'https://api.leadconnectorhq.com/widget/form/ZiepwgoZzuozaOg3NIkl';
---
<dialog id="consultation-form" class="form-modal" aria-labelledby="consultation-form-title">
  <div class="modal-shell">
    <div class="modal-header"><div><p>Private consultation</p><h2 id="consultation-form-title">Tell us about your property.</h2></div><button class="close" type="button" aria-label="Close consultation form">×</button></div>
    <iframe data-ghl-src={formUrl} title="PROJECT:automate consultation form" loading="lazy"></iframe>
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#consultation-form');
  const iframe = modal?.querySelector<HTMLIFrameElement>('iframe');
  const closeButton = modal?.querySelector<HTMLButtonElement>('.close');

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>('[data-ghl-form]');
    if (!trigger || !modal) return;
    event.preventDefault();
    if (iframe && !iframe.src) iframe.src = iframe.dataset.ghlSrc ?? '';
    modal.showModal();
  });

  closeButton?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
</script>

<style>
  .form-modal { background:transparent; border:0; max-height:100svh; max-width:min(760px,calc(100vw - 32px)); padding:0; width:100%; }
  .form-modal::backdrop { background:rgb(5 10 14 / .78); backdrop-filter:blur(6px); }
  .modal-shell { background:#f7f4ed; border:1px solid rgb(255 255 255 / .18); border-radius:22px; box-shadow:0 24px 80px rgb(0 0 0 / .45); overflow:hidden; }
  .modal-header { align-items:start; background:#121820; color:#fff; display:flex; justify-content:space-between; padding:1.3rem 1.4rem; }
  .modal-header p { color:#d9b384; font:700 .62rem/1.3 Inter,Arial,sans-serif; letter-spacing:.14em; margin:0 0 .45rem; text-transform:uppercase; }
  .modal-header h2 { font:500 clamp(1.7rem,4vw,2.3rem)/.95 'Cormorant Garamond',Georgia,serif; letter-spacing:-.04em; margin:0; }
  .close { background:transparent; border:1px solid rgb(255 255 255 / .3); border-radius:50%; color:#fff; font:300 1.7rem/.8 Arial,sans-serif; height:34px; width:34px; }
  iframe { background:#f7f4ed; border:0; display:block; height:min(76svh,850px); width:100%; }
  @media(max-width:680px) { .form-modal { max-width:calc(100vw - 20px); }.modal-header { padding:1.1rem; } iframe { height:78svh; } }
</style>

---
import { assetUrl } from '../../config/assets';
---
<a class="brand" href="/" aria-label="PROJECT:automate home"><img src={assetUrl('brandMark')} width="314" height="184" alt="" /><span><strong>PROJECT:</strong><strong>automate</strong></span></a>
<style>.brand{align-items:center;color:#fff;display:flex;flex-shrink:0;gap:.9rem;text-decoration:none;transform-origin:left center}.brand img{height:48px;object-fit:contain;width:66px}.brand span{display:grid;font:700 1rem/.9 Inter,Arial,sans-serif;letter-spacing:-.035em}.brand strong:last-child{color:#d9b384}@supports(animation-timeline:scroll()){.brand{animation:brand-scale linear both;animation-range:0 240px;animation-timeline:scroll(root)}@keyframes brand-scale{to{transform:scale(.72)}}}@media(max-width:900px){.brand{gap:.65rem}.brand img{height:34px;width:46px}.brand span{font-size:.77rem}}</style>

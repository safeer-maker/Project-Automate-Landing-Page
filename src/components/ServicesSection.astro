---
import { assetUrl } from '../config/assets';
const services = [['landscapeLightingService','Landscape Lighting','Architectural, pathway, and garden lighting designed with precision.'],['outdoorAudioService','Outdoor Audio','Discreet, high-performance audio that elevates outdoor living.'],['smartControlService','Smart Control','Effortless control of lighting, audio, and outdoor environments.']] as const;
---
<section id="services" class="section" aria-labelledby="services-title"><div class="container"><div class="heading"><p class="eyebrow">One complete outdoor experience</p><h2 id="services-title">Lighting, audio, and control—designed to work together.</h2></div><div class="services">{services.map(([id,title,copy])=><article><img src={assetUrl(id)} alt={title} loading="lazy"/><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="cta"><a href="#booking">Start your consultation <span>→</span></a></div></div></section>
<style>.section{background:#f7f4ed;padding:clamp(5.5rem,9vw,8.5rem) 0}.container{margin-inline:auto;width:min(1200px,calc(100% - 80px))}.heading{margin-bottom:clamp(3rem,6vw,5.5rem);max-width:850px}.eyebrow{color:#b68a5e;font:700 .69rem/1.3 Inter,Arial,sans-serif;letter-spacing:.16em;margin:0 0 1.15rem;text-transform:uppercase}h2,h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;letter-spacing:-.045em;line-height:.98;margin:0}h2{font-size:clamp(3rem,5.2vw,4.65rem)}h3{font-size:clamp(1.75rem,2.4vw,2.45rem)}.services{display:grid;gap:1.5rem;grid-template-columns:repeat(3,1fr)}img{aspect-ratio:1.35;border-radius:20px;object-fit:cover;width:100%}h3{margin:1.25rem 0 .6rem}article p{color:#5f6670;font:.92rem/1.65 Inter,Arial,sans-serif;margin-bottom:0}.cta{margin-top:3rem;text-align:center}.cta a{align-items:center;background:#121820;border-radius:999px;color:#fff;display:inline-flex;font:700 .72rem/1 Inter,Arial,sans-serif;gap:.8rem;letter-spacing:.07em;padding:1.15rem 1.55rem;text-decoration:none;text-transform:uppercase}@media(max-width:900px){.container{width:min(1200px,calc(100% - 40px))}}@media(max-width:680px){.section{padding:5.25rem 0}.services{gap:2.5rem;grid-template-columns:1fr}.cta a{width:100%}}</style>

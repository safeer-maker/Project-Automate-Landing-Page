---
import Layout from '../layouts/Layout.astro';
import GhlInlineForm from '../components/GhlInlineForm.astro';
---

<Layout title="Request a Consultation | PROJECT:automate" description="Start a private landscape lighting consultation with PROJECT:automate.">
  <section class="schedule-page">
    <div class="schedule-page__copy"><p>Private consultation</p><h1>Let’s design your life after sunset.</h1><span>Tell us about your estate, goals, timing, and investment range. Our design team will review your project and get in touch.</span><a href="/">← Return home</a></div>
    <GhlInlineForm title="Tell Us About Your Project" />
  </section>
</Layout>

<style>
  :global(html), :global(body) { background: #121820; }.schedule-page { display: grid; gap: clamp(2rem,5vw,5rem); grid-template-columns: minmax(0,.8fr) minmax(0,1fr); margin: 0 auto; max-width: 1200px; min-height: 100svh; padding: clamp(2rem,7vw,7rem) 40px; }.schedule-page__copy { align-self: center; color: #fff; }.schedule-page__copy p { color: #b68a5e; font: 700 .7rem/1.3 Inter,Arial,sans-serif; letter-spacing: .16em; margin: 0 0 1.25rem; text-transform: uppercase; }.schedule-page__copy h1 { font: 500 clamp(3.4rem,6vw,5.6rem)/.9 'Cormorant Garamond',Georgia,serif; letter-spacing: -.05em; margin: 0; }.schedule-page__copy span { color: #dcd4c8; display: block; font: 1rem/1.65 Inter,Arial,sans-serif; margin-top: 1.75rem; }.schedule-page__copy a { color: #fff; display: inline-block; font: 700 .72rem/1 Inter,Arial,sans-serif; letter-spacing: .1em; margin-top: 2rem; text-decoration: none; text-transform: uppercase; } @media (max-width:809px) { .schedule-page { grid-template-columns: 1fr; padding: 6rem 20px 3rem; }.schedule-page__copy h1 { font-size: clamp(3.25rem,15vw,4.6rem); } }
</style>

---
import GhlInlineForm from './GhlInlineForm.astro';
import { siteInfo, socialLogos } from '../config/site';

const contactItems = [
  {
    label: 'Call Us',
    value: '(310) 740-5375',
    href: 'tel:+13107405375',
    icon: 'phone',
  },
  {
    label: 'Email Us',
    value: 'sales@projectautomate.com',
    href: 'mailto:sales@projectautomate.com',
    icon: 'email',
  },
] as const;

// TikTok's own logo has a white note for dark backgrounds; this cream section uses its dark-note version.
const socialIconFile = (icon: string) => (icon === 'tiktok' ? 'tiktok-dark' : icon);
---

<section class="consultation" aria-labelledby="consultation-title">
  <div class="container consultation-layout">
    {
      /* The form comes first: it rises into the bottom of the hero, so it's on the first screen.
         The page's consultation links point at it (#consultation-form). */
    }
    <div id="consultation-form" class="form-column" data-reveal style="--reveal-delay: 100ms">
      <div class="form-shell">
        <GhlInlineForm
          title="Request Your Free Consultation"
          description="Share a few details below and our design team will follow up within one business day."
          variant="glass"
        />
      </div>
    </div>

    <div class="consultation-copy">
      <header data-reveal>
        <h2 id="consultation-title">Request a Private Lighting Consultation</h2>
        <p class="subhead">
          Tell us about your property and goals — our design team reviews every request and
          typically responds within one business day.
        </p>
      </header>

      <ul
        class="social"
        aria-label="Follow PROJECT: automate"
        data-reveal
        style="--reveal-delay: 40ms"
      >
        {
          siteInfo.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" title={s.label}>
                <img
                  src={`/images/social/${socialIconFile(s.icon)}.svg`}
                  alt=""
                  width={socialLogos[s.icon].width}
                  height={socialLogos[s.icon].height}
                  loading="lazy"
                  decoding="async"
                />
                <span class="visually-hidden">{s.label} (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="contact-list">
        {
          contactItems.map((item, index) => (
            <a
              class="contact-item"
              href={item.href}
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <span class="contact-item__icon" aria-hidden="true">
                {item.icon === 'phone' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M21 16.7v2.7a1.8 1.8 0 0 1-2 1.8A18.2 18.2 0 0 1 2.8 5a1.8 1.8 0 0 1 1.8-2h2.7A1.8 1.8 0 0 1 9 4.5c.1.9.4 1.8.7 2.7a1.8 1.8 0 0 1-.4 1.9L8.2 10.2a14.7 14.7 0 0 0 5.6 5.6l1.1-1.1a1.8 1.8 0 0 1 1.9-.4c.9.3 1.8.6 2.7.7a1.8 1.8 0 0 1 1.5 1.7Z" />
                  </svg>
                )}
                {item.icon === 'email' && (
                  <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m4 7 8 6 8-6" />
                  </svg>
                )}
              </span>
              <span>
                <strong>{item.label}</strong>
                <span>{item.value}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // The buttons link to the form. Scroll it in under the header, and once scrolling settles give it
  // a brief glow so it's clear where to start.
  const formShell = document.querySelector<HTMLElement>('.form-shell');

  if (formShell) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Move focus along with the scroll, so keyboard and screen-reader users land on the form too.
    const formHeading = formShell.querySelector<HTMLElement>('#ghl-inline-title');
    formHeading?.setAttribute('tabindex', '-1');
    let settleTimer: number | undefined;

    const glow = () => {
      formShell.classList.remove('is-arriving');
      void formShell.offsetWidth; // restart the animation on repeat clicks
      formShell.classList.add('is-arriving');
    };

    const waitForScrollToSettle = () => {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        window.removeEventListener('scroll', waitForScrollToSettle);
        glow();
      }, 140);
    };

    document.querySelectorAll<HTMLAnchorElement>('a[data-ghl-form]').forEach((link) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        formShell.scrollIntoView({
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
        formHeading?.focus({ preventScroll: true });
        window.addEventListener('scroll', waitForScrollToSettle, { passive: true });
        waitForScrollToSettle();
      }),
    );

    formShell.addEventListener('animationend', () => formShell.classList.remove('is-arriving'));

    // Lets the buttons stop animating while the form is on screen (see global.css).
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) =>
          document.documentElement.toggleAttribute('data-form-in-view', entry.isIntersecting),
        { threshold: 0.2 },
      ).observe(formShell);
    }
  }
</script>

<style>
  /* Stacks above the hero, so the form can rise into it (by --form-overlap, set in global.css). */
  .consultation {
    --consultation-pad: clamp(4.25rem, 5vw, 5.5rem);
    background: #f7f4ed;
    color: #121820;
    padding: var(--consultation-pad) 0;
    position: relative;
    z-index: 2;
  }

  .container {
    margin-inline: auto;
    width: min(var(--page-max), calc(100% - var(--page-gutter) - var(--page-gutter)));
  }

  .consultation-layout {
    align-items: start;
    display: grid;
    gap: clamp(2.25rem, 3.5vw, 4rem);
    grid-template-columns: minmax(300px, 1fr) clamp(480px, 38vw, 560px);
  }

  /* The copy stays pinned below the fixed header while the taller form scrolls past it. */
  .consultation-copy {
    grid-column: 1;
    grid-row: 1;
    padding-block: 1.5rem;
    position: sticky;
    top: 96px;
  }

  h2 {
    font:
      400 clamp(2.8rem, 3.45vw, 3.2rem) / 1.02 Arial,
      Helvetica,
      sans-serif;
    letter-spacing: -0.05em;
    margin: 0;
    max-width: 500px;
    text-transform: uppercase;
  }

  .subhead {
    color: #5f6670;
    font:
      0.94rem/1.6 Inter,
      Arial,
      sans-serif;
    margin: 1.15rem 0 0;
    max-width: 460px;
  }

  /* The logos have different shapes, so each sits in the same 46px circle (the contact icons'
     style) and fits a 24px box. That keeps the row evenly spaced. It lines up with the copy on
     desktop and is centred once the layout stacks. */
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-start;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .social a {
    background: #fff;
    border: 1px solid rgb(182 138 94 / 0.3);
    border-radius: 50%;
    display: grid;
    height: 46px;
    place-items: center;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    width: 46px;
  }

  .social img {
    height: 24px;
    object-fit: contain;
    width: 24px;
  }

  .social a:hover,
  .social a:focus-visible {
    border-color: #b68a5e;
    box-shadow: 0 8px 18px -10px rgb(18 24 32 / 0.35);
    transform: translateY(-2px);
  }

  .social a:focus-visible {
    outline: 2px solid #b68a5e;
    outline-offset: 2px;
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .social a:hover,
    .social a:focus-visible {
      transform: none;
    }
  }

  .contact-list {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
  }

  .contact-item {
    align-items: flex-start;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 38px minmax(0, 1fr);
    text-decoration: none;
  }

  .contact-item__icon {
    align-items: center;
    border: 1px solid rgb(182 138 94 / 0.3);
    border-radius: 50%;
    color: #b68a5e;
    display: inline-flex;
    height: 34px;
    justify-content: center;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
    width: 34px;
  }

  .contact-item:hover .contact-item__icon {
    background: #b68a5e;
    color: #fff;
  }

  .contact-item svg {
    fill: none;
    height: 15px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    width: 15px;
  }

  .contact-item strong,
  .contact-item > span:last-child > span {
    display: block;
  }

  .contact-item strong {
    font:
      600 0.67rem/1.2 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.04em;
    margin: 0.1rem 0 0.3rem;
    text-transform: uppercase;
  }

  .contact-item > span:last-child > span {
    color: #5f6670;
    font:
      0.83rem/1.5 Inter,
      Arial,
      sans-serif;
  }

  /* No photo behind the form, so the hero video shows around it. */
  .form-column {
    grid-column: 2;
    grid-row: 1;
    margin-top: calc(-1 * (var(--form-overlap) + var(--consultation-pad)));
  }

  .form-shell {
    border-radius: 20px;
    position: relative;
    z-index: 1;
  }

  .form-shell.is-arriving {
    animation: form-arrive 1.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes form-arrive {
    0% {
      box-shadow:
        0 0 0 0 rgb(214 169 111 / 0),
        0 0 0 0 rgb(214 169 111 / 0);
    }
    30% {
      box-shadow:
        0 0 0 3px rgb(214 169 111 / 0.85),
        0 0 40px 6px rgb(214 169 111 / 0.4);
    }
    100% {
      box-shadow:
        0 0 0 14px rgb(214 169 111 / 0),
        0 0 40px 6px rgb(214 169 111 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-shell.is-arriving {
      animation: none;
    }
  }

  @media (max-width: 1199px) {
    .consultation {
      padding-top: 0;
    }

    .consultation-layout {
      grid-template-columns: 1fr;
    }

    .form-column,
    .consultation-copy {
      grid-column: auto;
      grid-row: auto;
    }

    .form-column {
      margin-top: calc(-1 * var(--form-overlap));
    }

    .consultation-copy {
      padding-block: 0;
      position: static;
    }

    .social {
      justify-content: center;
    }

    .consultation-copy header {
      max-width: 700px;
    }

    .contact-list {
      gap: 1.5rem 2rem;
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 809px) {
    .consultation {
      padding-bottom: 3.75rem;
    }

    h2 {
      font-size: clamp(2.45rem, 10.5vw, 2.9rem);
    }

    .contact-list {
      grid-template-columns: 1fr;
    }
  }
</style>

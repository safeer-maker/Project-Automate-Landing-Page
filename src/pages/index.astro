---
import Layout from '../layouts/Layout.astro';
import GhlInlineForm from '../components/GhlInlineForm.astro';
import { assetUrl } from '../config/assets';

const features = [
  ['revealArchitecture', 'Reveal architecture', 'Accentuate the details that make your home unique.'],
  ['highlightLandscaping', 'Highlight landscaping', 'Showcase mature trees, texture, and natural beauty.'],
  ['improveSafety', 'Improve safety', 'Create comfortable, well-lit pathways and entryways.'],
] as const;

const services = [
  ['landscapeLightingService', 'Landscape Lighting', 'Architectural, pathway, and garden lighting designed with precision.'],
  ['outdoorAudioService', 'Outdoor Audio', 'Discreet, high-performance audio that elevates outdoor living.'],
  ['smartControlService', 'Smart Control', 'Effortless control of lighting, audio, and outdoor environments.'],
] as const;

const steps = [
  ['01', 'Discovery', 'We learn about your property, priorities, timeline, and investment range.'],
  ['02', 'Site Evaluation', 'We study the architecture, landscaping, sightlines, and technical requirements.'],
  ['03', 'Design & Installation', 'You receive a tailored lighting design and detailed proposal before installation.'],
  ['04', 'Fine-Tuning & Support', 'We adjust every scene after dark and remain available for ongoing support.'],
] as const;
---

<Layout
  title="Architectural Landscape Lighting | PROJECT:automate"
  description="Architectural landscape lighting, outdoor audio, and seamless control for Los Angeles estates."
  ogImage={assetUrl('heroEstateAtSunset')}
>
  <header class="header">
    <nav class="container nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="PROJECT:automate home">
        <img src={assetUrl('brandMark')} width="314" height="184" alt="PROJECT:automate" />
        <span class="brand-name" aria-hidden="true"><b>PROJECT:</b><b>automate</b></span>
      </a>
      <div class="nav-actions">
        <a class="phone" href="tel:+13107405375">(310) 740-5375</a>
        <a class="button button-small" href="#booking">Book a consultation <span aria-hidden="true">→</span></a>
      </div>
    </nav>
  </header>

  <section class="hero" aria-labelledby="hero-title">
    <img src={assetUrl('heroEstateAtSunset')} width="5376" height="3072" alt="Illuminated luxury estate with a pool at sunset" fetchpriority="high" />
    <div class="hero-overlay"></div>
    <div class="container hero-copy">
      <p class="eyebrow">Architectural landscape lighting · Los Angeles</p>
      <h1 id="hero-title">Your estate shouldn’t disappear after sunset.</h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <div class="hero-actions">
        <a class="button" href="#booking">Request a private lighting consultation <span aria-hidden="true">→</span></a>
        <a class="hero-phone" href="tel:+13107405375">Or call (310) 740-5375</a>
      </div>
      <p class="hero-lead">Tell us about your property, project goals, timing, and investment range. Our design team reviews every project before scheduling the next step.</p>
    </div>
  </section>

  <section class="trust" aria-label="Professional credentials">
    <div class="container trust-grid">
      <article><img src={assetUrl('htaCertification')} width="2000" height="971" alt="HTA Certified" /><div><b>HTA Certified</b><span>Home Technology Association</span></div></article>
      <article><img src={assetUrl('cediaMembership')} width="1668" height="1043" alt="CEDIA member" /><div><b>CEDIA Member</b><span>Industry-recognized expertise</span></div></article>
      <article><img src={assetUrl('industryMembership')} width="450" height="360" alt="Smart home industry member" /><div><b>17+ Years</b><span>Smart home industry experience</span></div></article>
    </div>
  </section>

  <section class="light section" aria-labelledby="benefits-title">
    <div class="container">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">Designed for life after sunset</p><h2 id="benefits-title">Your home was designed to be experienced.</h2></div>
        <p>From subtle path lighting to dramatic architectural washes, every layer of light has a purpose—enhancing beauty, improving safety, and extending your lifestyle outdoors.</p>
      </div>
      <div class="feature-grid">
        {features.map(([id, title, copy], index) => (
          <figure class:list={['feature', index === 0 && 'feature-tall']}>
            <img src={assetUrl(id)} alt={title} loading="lazy" />
            <figcaption><b>{title}</b><span>{copy}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="dark section" aria-labelledby="project-title">
    <div class="container case-study">
      <div class="case-images">
        <img src={assetUrl('projectCaseStudy')} width="1280" height="1280" alt="Completed landscape lighting redesign" loading="lazy" />
        <img src={assetUrl('projectCaseStudyDetail')} width="620" height="333" alt="Subtle lighting detail along the property" loading="lazy" />
      </div>
      <div class="case-copy">
        <p class="eyebrow">A real project</p>
        <h2 id="project-title">Lighting that reveals the property after dark.</h2>
        <p>A dated system was redesigned with layered architectural, landscape, and pathway lighting—bringing depth to the property without overpowering it.</p>
        <a class="text-link" href="#booking">Discuss your property <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="container process">
      <div class="section-heading split-heading process-heading">
        <div><p class="eyebrow">Our design + build process</p><h2>A considered process from first conversation to final adjustment.</h2></div>
        <img src={assetUrl('designBuildProcess')} width="1200" height="1000" alt="Landscape lighting design and installation process" loading="lazy" />
      </div>
      <ol class="steps">
        {steps.map(([number, title, copy]) => <li><span>{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="light section services-section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading services-heading">
        <p class="eyebrow">One complete outdoor experience</p>
        <h2 id="services-title">Lighting, audio, and control—designed to work together.</h2>
      </div>
      <div class="services">
        {services.map(([id, title, copy]) => <article><img src={assetUrl(id)} alt={title} loading="lazy" /><h3>{title}</h3><p>{copy}</p></article>)}
      </div>
      <div class="section-cta"><a class="button button-dark" href="#booking">Start your consultation <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section id="booking" class="consultation section" aria-labelledby="booking-title">
    <div class="container consultation-grid">
      <div class="consultation-intro">
        <div>
          <p class="eyebrow">Private consultation</p>
          <h2 id="booking-title">Tell us about your property.</h2>
          <p>Share your goals, timing, and project details. Our design team will review your request and contact you about the right next step.</p>
        </div>
        <figure>
          <img src={assetUrl('consultationContact')} width="941" height="1672" alt="Private outdoor living space illuminated at sunset" loading="lazy" />
          <figcaption>Prefer to speak directly? <a href="tel:+13107405375">Call (310) 740-5375</a></figcaption>
        </figure>
      </div>
      <GhlInlineForm title="Request Your Consultation" />
    </div>
  </section>

  <footer class="footer">
    <div class="container"><span>© {new Date().getFullYear()} PROJECT:automate</span><span>Architectural lighting and outdoor technology · Los Angeles</span><a href="tel:+13107405375">(310) 740-5375</a></div>
  </footer>
</Layout>

<style>
  :global(html), :global(body) { background: #f7f4ed; color: #121820; }
  :global(body) { margin: 0; }
  .container { margin-inline: auto; width: min(1200px, calc(100% - 80px)); }
  .section { padding-block: clamp(5.5rem, 9vw, 8.5rem); }
  .light { background: #f7f4ed; }
  .dark, .consultation { background: #121820; color: #fff; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; letter-spacing: -.045em; line-height: .98; margin: 0; }
  h2 { font-size: clamp(3rem, 5.2vw, 4.65rem); }
  h3 { font-size: clamp(1.75rem, 2.4vw, 2.45rem); }
  p { font: 1rem/1.65 Inter, Arial, sans-serif; }
  .eyebrow { color: #b68a5e; font: 700 .69rem/1.3 Inter, Arial, sans-serif; letter-spacing: .16em; margin: 0 0 1.15rem; text-transform: uppercase; }
  .button { align-items: center; background: #b68a5e; border-radius: 999px; color: #fff; display: inline-flex; font: 700 .72rem/1 Inter, Arial, sans-serif; gap: .8rem; justify-content: center; letter-spacing: .07em; padding: 1.15rem 1.55rem; text-decoration: none; text-transform: uppercase; transition: background .2s ease, transform .2s ease; }
  .button:hover { background: #9d7049; transform: translateY(-2px); }
  .button:focus-visible, .text-link:focus-visible, .hero-phone:focus-visible, .phone:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .button-small { font-size: .66rem; padding: .85rem 1.05rem; }

  .header { left: 0; padding-top: 1.25rem; position: absolute; right: 0; top: 0; z-index: 2; }
  .nav { align-items: center; backdrop-filter: blur(10px); background: #fff9; border: 1px solid #fffc; border-radius: 999px; display: flex; justify-content: space-between; min-height: 68px; padding: .4rem 1rem .4rem 1.25rem; }
  .brand { align-items: center; color: #fff; display: flex; gap: .65rem; text-decoration: none; }
  .brand img { height: 38px; object-fit: cover; width: 42px; }
  .brand-name { display: grid; font: 700 .78rem/.95 Inter, Arial, sans-serif; }
  .nav-actions { align-items: center; display: flex; gap: 1.25rem; }
  .phone { color: #fff; font: 700 .92rem Inter, Arial, sans-serif; text-decoration: none; }

  .hero { color: #fff; display: grid; min-height: max(720px, 100svh); overflow: hidden; position: relative; }
  .hero > img, .hero-overlay { height: 100%; inset: 0; object-fit: cover; position: absolute; width: 100%; }
  .hero > img { object-position: 58% center; }
  .hero-overlay { background: linear-gradient(90deg, #081014e8 0%, #081014a6 43%, #08101424 76%), linear-gradient(0deg, #0810148a 0%, transparent 50%); }
  .hero-copy { align-self: center; padding-bottom: 3rem; padding-top: 8.5rem; position: relative; z-index: 1; }
  .hero h1 { animation: reveal .9s both; font-family: Arial, Helvetica, sans-serif; font-size: clamp(3.5rem, 4.65vw, 4.2rem); font-weight: 400; letter-spacing: -.04em; line-height: 1; max-width: 700px; }
  .hero-rule { animation: reveal .9s .1s both; background: #b68a5e; display: block; height: 2px; margin: 1.45rem 0 1.25rem; width: min(245px, 45vw); }
  .hero-lead { animation: reveal .9s .3s both; color: #eee9e2; font-size: .82rem; line-height: 1.45; margin: 1.25rem 0 0; max-width: 560px; }
  .hero-actions { align-items: center; animation: reveal .9s .2s both; display: flex; flex-wrap: wrap; gap: 1.1rem 1.5rem; }
  .hero-phone { color: #fff; font: 600 .75rem/1 Inter, Arial, sans-serif; letter-spacing: .04em; text-decoration: none; }
  @keyframes reveal { from { filter: blur(10px); opacity: .01; transform: translateY(10px); } }

  .trust { background: #f7f4ed; padding-block: 2.25rem; }
  .trust-grid { display: grid; gap: 2rem; grid-template-columns: repeat(3, 1fr); }
  .trust article { align-items: center; display: flex; gap: 1rem; min-width: 0; }
  .trust img { height: 50px; object-fit: contain; width: 70px; }
  .trust b, .trust span { display: block; font-family: Inter, Arial, sans-serif; }
  .trust b { font-size: .85rem; }
  .trust span { color: #5f6670; font-size: .72rem; margin-top: .25rem; }

  .section-heading { margin-bottom: clamp(3rem, 6vw, 5.5rem); }
  .split-heading { align-items: end; display: grid; gap: clamp(2rem, 7vw, 7rem); grid-template-columns: 1.15fr .85fr; }
  .split-heading > p { color: #5f6670; margin: 0 0 .35rem; max-width: 520px; }
  .feature-grid { display: grid; gap: 1.25rem; grid-template-columns: .92fr 1.08fr; grid-template-rows: repeat(2, minmax(280px, 330px)); }
  .feature { border-radius: 20px; margin: 0; overflow: hidden; position: relative; }
  .feature-tall { grid-row: span 2; }
  .feature img { height: 100%; object-fit: cover; transition: transform .6s ease; width: 100%; }
  .feature:hover img { transform: scale(1.025); }
  .feature figcaption { background: linear-gradient(0deg, #000d, transparent); bottom: 0; color: #fff; display: grid; gap: .35rem; left: 0; padding: 2rem; position: absolute; right: 0; }
  .feature b { font: 700 .7rem/1.3 Inter, Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; }
  .feature span { font: .9rem/1.4 Inter, Arial, sans-serif; }

  .case-study { align-items: center; display: grid; gap: clamp(3rem, 8vw, 8rem); grid-template-columns: 1.12fr .88fr; }
  .case-images { display: grid; grid-template-columns: minmax(0, 1fr) minmax(150px, .58fr); position: relative; }
  .case-images img { border-radius: 20px; object-fit: cover; width: 100%; }
  .case-images img:first-child { aspect-ratio: 1; }
  .case-images img:last-child { align-self: end; aspect-ratio: 1.2; border: 8px solid #121820; margin-left: -18%; margin-bottom: 8%; position: relative; }
  .case-copy h2 { font-size: clamp(3rem, 4.7vw, 4.4rem); }
  .case-copy > p:last-of-type { color: #dcd4c8; margin: 1.5rem 0 1.75rem; max-width: 500px; }
  .text-link { color: #fff; font: 700 .72rem/1 Inter, Arial, sans-serif; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .text-link span { color: #b68a5e; margin-left: .55rem; }
  .process { border-top: 1px solid #ffffff2e; margin-top: clamp(5rem, 10vw, 9rem); padding-top: clamp(5rem, 8vw, 7.5rem); }
  .process-heading { align-items: center; }
  .process-heading img { border-radius: 20px; height: clamp(260px, 28vw, 390px); object-fit: cover; width: 100%; }
  .steps { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; padding: 0; }
  .steps li { border-top: 1px solid #ffffff3d; display: grid; gap: 1.25rem; grid-template-columns: 48px 1fr; list-style: none; padding: 2rem 2rem 2rem 0; }
  .steps li:nth-child(odd) { margin-right: 2rem; }
  .steps li > span { color: #b68a5e; font: 500 2rem/1 'Cormorant Garamond', Georgia, serif; }
  .steps h3 { font-size: 1.75rem; }
  .steps p { color: #dcd4c8; font-size: .9rem; margin: .65rem 0 0; }

  .services-heading { max-width: 850px; }
  .services { display: grid; gap: 1.5rem; grid-template-columns: repeat(3, 1fr); }
  .services img { aspect-ratio: 1.35; border-radius: 20px; object-fit: cover; width: 100%; }
  .services h3 { margin: 1.25rem 0 .6rem; }
  .services article p { color: #5f6670; font-size: .92rem; margin-bottom: 0; }
  .section-cta { margin-top: 3rem; text-align: center; }
  .button-dark { background: #121820; }
  .button-dark:hover { background: #27313d; }

  .consultation { scroll-margin-top: 1rem; }
  .consultation-grid { align-items: start; display: grid; gap: clamp(3rem, 7vw, 7rem); grid-template-columns: minmax(0, .78fr) minmax(420px, 1fr); }
  .consultation-intro { display: grid; gap: 2.5rem; }
  .consultation-intro > div > p:last-child { color: #dcd4c8; margin: 1.5rem 0 0; max-width: 500px; }
  .consultation-intro figure { margin: 0; }
  .consultation-intro img { aspect-ratio: 1.65; border-radius: 20px; object-fit: cover; object-position: center 58%; width: 100%; }
  .consultation-intro figcaption { color: #dcd4c8; font: .78rem/1.5 Inter, Arial, sans-serif; margin-top: .9rem; }
  .consultation-intro figcaption a { color: #fff; font-weight: 700; }
  .consultation-grid > :global(.ghl-inline) { min-width: 0; }

  .footer { background: #0b1016; color: #cfc8bd; padding-block: 1.5rem; }
  .footer .container { align-items: center; display: flex; flex-wrap: wrap; font: .68rem/1.5 Inter, Arial, sans-serif; gap: .75rem 2rem; justify-content: space-between; letter-spacing: .04em; }
  .footer a { color: #fff; font-weight: 700; text-decoration: none; }

  @media (max-width: 900px) {
    .container { width: min(100% - 40px, 1200px); }
    .header { padding-top: .75rem; }
    .nav { min-height: 58px; }
    .brand img { height: 32px; width: 35px; }
    .brand-name { font-size: .68rem; }
    .phone { display: none; }
    .hero { min-height: max(680px, 100svh); }
    .hero h1 { font-size: clamp(3.15rem, 12.5vw, 4rem); }
    .trust-grid { gap: 1.25rem; }
    .split-heading, .case-study, .consultation-grid { grid-template-columns: 1fr; }
    .split-heading { align-items: start; gap: 1.75rem; }
    .case-study { gap: 3rem; }
    .case-images { max-width: 680px; }
    .consultation-grid { gap: 3.5rem; }
    .consultation-intro { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 680px) {
    .section { padding-block: 5.25rem; }
    .button-small { padding-inline: .9rem; }
    .hero-copy { align-self: end; padding-bottom: 3.5rem; padding-top: 8rem; }
    .hero-actions { align-items: flex-start; flex-direction: column; }
    .hero-actions .button { width: 100%; }
    .trust { padding-block: 1.75rem; }
    .trust-grid { grid-template-columns: 1fr; }
    .trust img { height: 42px; width: 62px; }
    .feature-grid { display: grid; grid-template-columns: 1fr; grid-template-rows: none; }
    .feature, .feature-tall { aspect-ratio: 1.2; grid-row: auto; }
    .feature figcaption { padding: 1.5rem; }
    .case-images { grid-template-columns: 1fr .5fr; }
    .process-heading img { height: 260px; }
    .steps, .services { grid-template-columns: 1fr; }
    .steps li:nth-child(odd) { margin-right: 0; }
    .services { gap: 2.5rem; }
    .section-cta .button { width: 100%; }
    .consultation-intro { grid-template-columns: 1fr; }
    .consultation-intro img { aspect-ratio: 1.4; }
    .footer .container { align-items: flex-start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1, .hero-lead, .hero-actions { animation: none; }
    .feature img, .button { transition: none; }
  }
</style>

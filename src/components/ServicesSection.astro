---
import { assetUrl } from '../config/assets';

const services = [
  {
    id: 'landscapeLightingService',
    title: 'Landscape Lighting',
    copy: 'Architectural, pathway and garden lighting designed with precision.',
    icon: 'landscape',
  },
  {
    id: 'outdoorAudioService',
    title: 'Outdoor Audio',
    copy: 'Discreet, high-performance audio that elevates your outdoor lifestyle.',
    icon: 'audio',
  },
  {
    id: 'smartControlService',
    title: 'Smart Control',
    copy: 'Effortless control of lighting, audio and environments from anywhere.',
    icon: 'control',
  },
] as const;
---

<section id="services" class="services-section" aria-labelledby="services-title">
  <div class="container">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Complete outdoor experience</p>
      <h2 id="services-title">Landscape Lighting. Outdoor Audio. Seamless Control.</h2>
      <p class="intro">Outdoor spaces designed to feel as connected as your home.</p>
    </header>

    <div class="services-grid">
      {
        services.map((service, index) => (
          <article
            class:list={['service-card', `service-card--${service.icon}`]}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <img
              src={assetUrl(service.id)}
              alt={`${service.title} installation at a luxury residence`}
              loading="lazy"
              decoding="async"
            />
            <div class="service-card__content">
              {service.icon === 'landscape' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 20V9l8-5 8 5v11h-6v-6h-4v6H4Z" />
                  <path d="M3 20h18M5 6l2-3M19 6l-2-3" />
                </svg>
              )}
              {service.icon === 'audio' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 9v6M8 6v12M12 9v6M16 4v16M20 8v8" />
                </svg>
              )}
              {service.icon === 'control' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 9a10 10 0 0 1 14 0M8 12a6 6 0 0 1 8 0M11 15a2 2 0 0 1 2 0" />
                  <circle cx="12" cy="18" r="1" />
                </svg>
              )}
              <div>
                <h3>{service.title}</h3>
                <p>{service.copy}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-section {
    background: #f7f4ed;
    color: #121820;
    padding: 0 0 clamp(4.25rem, 5vw, 5.5rem);
    scroll-margin-top: 90px;
  }

  .container {
    margin-inline: auto;
    width: min(var(--page-max), calc(100% - var(--page-gutter) - var(--page-gutter)));
  }

  .section-heading {
    margin-bottom: 2.8rem;
    max-width: 820px;
  }

  .eyebrow {
    color: #b68a5e;
    font:
      700 0.7rem/1 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.14em;
    margin: 0 0 1.1rem;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    font:
      400 clamp(2.65rem, 3.4vw, 3rem) / 1.05 Arial,
      Helvetica,
      sans-serif;
    letter-spacing: -0.045em;
    margin-bottom: 1.35rem;
  }

  .intro {
    color: #5f6670;
    font:
      1rem/1.6 Inter,
      Arial,
      sans-serif;
    margin-bottom: 0;
  }

  .services-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .service-card {
    border: 2px solid #fff;
    border-radius: 20px;
    box-shadow: 0 12px 30px rgb(31 36 40 / 0.08);
    height: clamp(360px, 28vw, 430px);
    overflow: hidden;
    position: relative;
  }

  .service-card::after {
    background: linear-gradient(180deg, transparent 45%, rgb(4 9 13 / 0.38));
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .service-card > img {
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  .service-card--audio > img {
    object-position: 22% 39%;
  }

  .service-card:hover > img {
    transform: scale(1.035);
  }

  .service-card__content {
    align-items: center;
    backdrop-filter: blur(18px);
    background: rgb(255 255 255 / 0.78);
    border: 1px solid rgb(255 255 255 / 0.82);
    border-radius: 12px;
    bottom: 12px;
    box-shadow:
      0 24px 50px -20px rgb(0 0 0 / 0.24),
      inset 0 2px 18px rgb(255 255 255 / 0.78);
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 38px minmax(0, 1fr);
    left: 12px;
    padding: 1rem 1.05rem;
    position: absolute;
    right: 12px;
    z-index: 1;
  }

  .service-card__content svg {
    fill: none;
    height: 30px;
    stroke: #b68a5e;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
    width: 30px;
  }

  .service-card__content h3 {
    font:
      500 0.78rem/1.2 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.035em;
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }

  .service-card__content p {
    color: #5f6670;
    font:
      0.68rem/1.5 Inter,
      Arial,
      sans-serif;
    margin-bottom: 0;
  }

  @media (max-width: 1199px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .service-card {
      height: 300px;
    }

    .service-card:last-child {
      grid-column: 1;
    }
  }

  @media (max-width: 809px) {
    .services-section {
      padding-bottom: 3.75rem;
    }

    .section-heading {
      margin-bottom: 2.4rem;
    }

    h2 {
      font-size: clamp(2.35rem, 10vw, 2.7rem);
    }

    .intro {
      font-size: 0.9rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card,
    .service-card:last-child {
      grid-column: auto;
      height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card > img {
      transition: none;
    }
  }
</style>

{
  "name": "pa-landing-page",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "assets:download": "node scripts/download-assets.mjs",
    "assets:download:force": "node scripts/download-assets.mjs --force",
    "assets:check": "node scripts/download-assets.mjs --dry-run",
    "assets:validate": "node scripts/download-assets.mjs --validate",
    "dev": "astro dev",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "start": "astro dev",
    "build": "npm run assets:download && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.2.7"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^4.144.0"
  }
}

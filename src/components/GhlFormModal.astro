---
// The iframe is rendered on initial page load so the form is ready when a CTA is selected.
---

<div class="ghl-modal" id="ghl-form-modal" aria-hidden="true">
  <div class="ghl-modal__backdrop" data-close-ghl-form></div>
  <section
    class="ghl-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ghl-form-modal-title"
  >
    <div class="ghl-modal__header">
      <div>
        <p class="ghl-modal__eyebrow">PROJECT:automate</p>
        <h2 id="ghl-form-modal-title">Start Your Outdoor Project</h2>
      </div>
      <button class="ghl-modal__close" type="button" aria-label="Close form" data-close-ghl-form>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="ghl-modal__body">
      <iframe
        src="https://api.leadconnectorhq.com/widget/form/ZiepwgoZzuozaOg3NIkl"
        id="modal-ZiepwgoZzuozaOg3NIkl"
        data-layout="{'id':'INLINE'}"
        data-height="1015"
        data-form-id="ZiepwgoZzuozaOg3NIkl"
        title="Project consultation form"
        loading="eager"
      ></iframe>
    </div>
  </section>
</div>

<script>
  const modal = document.getElementById('ghl-form-modal');
  const closeButton = modal?.querySelector('[data-close-ghl-form]');
  let opener: HTMLElement | null = null;

  const openForm = (trigger?: HTMLElement) => {
    if (!modal) return;
    opener = trigger ?? null;
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('ghl-modal-open');
    closeButton instanceof HTMLElement && closeButton.focus();
  };

  const closeForm = () => {
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('ghl-modal-open');
    opener?.focus();
  };

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>('[data-open-ghl-form]');
    if (trigger) {
      event.preventDefault();
      openForm(trigger);
      return;
    }

    if ((event.target as Element).closest('[data-close-ghl-form]')) closeForm();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal?.getAttribute('aria-hidden') === 'false') closeForm();
  });
</script>

<style>
  .ghl-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .ghl-modal[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
  }

  .ghl-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.76);
    backdrop-filter: blur(8px);
  }

  .ghl-modal__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(760px, 100%);
    height: min(92vh, 920px);
    background: #101014;
    border: 1px solid rgba(230, 165, 92, 0.35);
    border-radius: 16px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.65);
    overflow: hidden;
    transform: translateY(12px) scale(0.98);
    transition: transform 0.2s ease;
  }

  .ghl-modal[aria-hidden='false'] .ghl-modal__dialog { transform: translateY(0) scale(1); }

  .ghl-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ghl-modal__eyebrow { color: var(--accent-gold); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .ghl-modal__header h2 { margin-top: 0.15rem; font-size: clamp(1.15rem, 3vw, 1.45rem); }
  .ghl-modal__close { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; color: #fff; font-size: 2rem; line-height: 1; border-radius: 50%; }
  .ghl-modal__close:hover, .ghl-modal__close:focus-visible { background: rgba(255, 255, 255, 0.12); outline: none; }
  .ghl-modal__body { flex: 1; min-height: 0; overflow-y: auto; background: #fff; }
  .ghl-modal__body iframe { display: block; width: 100%; min-height: 1015px; border: 0; }

  :global(body.ghl-modal-open) { overflow: hidden; }

  @media (max-width: 640px) {
    .ghl-modal { padding: 0; }
    .ghl-modal__dialog { width: 100%; height: 100dvh; max-height: none; border-radius: 0; }
    .ghl-modal__body iframe { min-height: 1100px; }
  }
</style>

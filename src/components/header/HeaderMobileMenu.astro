---
import HeaderCtaButton from './HeaderCtaButton.astro';
---

<details class="mobile-menu">
  <summary><span>Menu</span><span class="menu-icon" aria-hidden="true"></span></summary><div
    class="mobile-panel"
  >
    <a class="mobile-phone" href="tel:+13107405375">Call (310) 740-5375</a><HeaderCtaButton
      compact
    />
  </div>
</details>
<style>
  .mobile-menu {
    display: none;
    margin-left: auto;
    position: relative;
  }
  .mobile-menu summary {
    align-items: center;
    color: #fff;
    cursor: pointer;
    display: flex;
    font:
      700 0.67rem/1 Inter,
      Arial,
      sans-serif;
    gap: 0.65rem;
    letter-spacing: 0.1em;
    list-style: none;
    padding: 0.85rem 0.7rem;
    text-transform: uppercase;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-icon,
  .menu-icon::before {
    background: currentColor;
    display: block;
    height: 1px;
    position: relative;
    width: 18px;
  }
  .menu-icon::before {
    content: '';
    position: absolute;
    top: -5px;
  }
  .mobile-panel {
    background: #10181e;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 18px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.28);
    display: grid;
    gap: 1.25rem;
    padding: 1.35rem;
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(290px, calc(100vw - 40px));
  }
  .mobile-phone {
    color: #d9b384;
    font:
      600 0.74rem/1 Inter,
      Arial,
      sans-serif;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .mobile-menu summary:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  @media (max-width: 900px) {
    .mobile-menu {
      display: block;
    }
  }
</style>

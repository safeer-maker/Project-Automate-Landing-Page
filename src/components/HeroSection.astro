---
import { assetUrl } from '../config/assets';
---
<section class="hero" aria-labelledby="hero-title">
  <img src={assetUrl('heroEstateAtSunset')} width="5376" height="3072" alt="Illuminated luxury estate with a pool at sunset" fetchpriority="high" />
  <div class="overlay"></div>
  <div class="container copy"><p class="eyebrow">Architectural landscape · Los Angeles</p><h1 id="hero-title">Your estate shouldn’t disappear after sunset.</h1><span class="rule"></span><div class="actions"><a class="button" href="#booking">Request a private lighting consultation <span>→</span></a><a class="phone" href="tel:+13107405375">Or call (310) 740-5375</a></div><p class="lead">Tell us about your property, project goals, timing, and investment range. Our design team reviews every project before scheduling the next step.</p></div>
</section>
<style>
  .container { margin-inline:auto; width:min(1200px,calc(100% - 80px)); }.hero{color:#fff;display:grid;min-height:max(720px,100svh);overflow:hidden;position:relative}.hero>img,.overlay{height:100%;inset:0;object-fit:cover;position:absolute;width:100%}.hero>img{object-position:58% center}.overlay{background:linear-gradient(90deg,#081014e8 0%,#081014a6 43%,#08101424 76%),linear-gradient(0deg,#0810148a 0%,transparent 50%)}.copy{align-self:center;padding:8.5rem 0 3rem;position:relative;z-index:1}.eyebrow{color:#d9b384;font:700 .69rem/1.3 Inter,Arial,sans-serif;letter-spacing:.16em;margin:0 0 1.15rem;text-transform:uppercase}.hero h1{font:400 clamp(3.5rem,4.65vw,4.2rem)/1 Arial,Helvetica,sans-serif;letter-spacing:-.04em;margin:0;max-width:700px}.rule{background:#b68a5e;display:block;height:2px;margin:1.45rem 0 1.25rem;width:min(245px,45vw)}.actions{align-items:center;display:flex;flex-wrap:wrap;gap:1.1rem 1.5rem}.button{align-items:center;background:#b68a5e;border-radius:999px;color:#fff;display:inline-flex;font:700 .72rem/1 Inter,Arial,sans-serif;gap:.8rem;letter-spacing:.07em;padding:1.15rem 1.55rem;text-decoration:none;text-transform:uppercase}.phone{color:#fff;font:600 .75rem/1 Inter,Arial,sans-serif;letter-spacing:.04em;text-decoration:none}.lead{color:#eee9e2;font:.82rem/1.45 Inter,Arial,sans-serif;margin:1.25rem 0 0;max-width:560px}@media(max-width:900px){.container{width:min(1200px,calc(100% - 40px))}.hero{min-height:max(680px,100svh)}.hero h1{font-size:clamp(3.15rem,12.5vw,4rem)}}@media(max-width:680px){.copy{align-self:end;padding:8rem 0 3.5rem}.actions{align-items:flex-start;flex-direction:column}.actions .button{width:100%}}
</style>
